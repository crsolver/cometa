{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cometa Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build Cometa extension",
      "timeout": 30000,
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/out/**/*.js"
      ]
    }
  ]
}
