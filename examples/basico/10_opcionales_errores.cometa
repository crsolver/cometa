// Opcionales (T?) y errores (T!): valores que pueden faltar o fallar.

// entero? puede tener un entero... o nada (.Ninguno).
fn buscar_edad(nombre cadena) entero?
	si nombre == "Ana" 12
	sino .Ninguno

// entero! devuelve un entero o un error con un mensaje.
fn dividir(a entero, b entero) entero!
	si b == 0
		retornar .Error("no se puede dividir entre cero")
	a / b

// intentar pasa el error hacia arriba si la operación falla.
fn mitad_de_division(a entero, b entero) entero!
	var resultado = intentar dividir(a, b)
	resultado / 2

fn inicio()
	// o: usar un valor por defecto si falta.
	imprimir(buscar_edad("Pedro") o 0)

	// si con |valor|: solo entra si hay valor.
	si buscar_edad("Ana") |edad|
		imprimir("Ana tiene ${edad} años")
	sino
		imprimir("No conozco a Ana")

	// capturar: decidir qué hacer si hay un error.
	var bien = dividir(10, 2) capturar 0
	imprimir(bien)

	var mal = dividir(10, 0) capturar |error|
		imprimir("Error: ${error}")
		-1
	imprimir(mal)

	imprimir(mitad_de_division(20, 2) capturar 0)
