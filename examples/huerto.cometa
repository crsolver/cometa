// ---------- Sprites ----------

fn espejo(img g.Imagen) g.Imagen
	var copia = lienzo.nuevo(lienzo.ancho(img), lienzo.alto(img))
	lienzo.pegar(copia, img, 0, 0, espejo_h = verdadero)
	copia

// Tercer cuadro de caminata: el paso con la otra pierna.
fn con_paso_espejo(cuadros [g.Imagen]) [g.Imagen]
	cuadros.agregar(espejo(cuadros[1]))
	cuadros

fn espejar(cuadros [g.Imagen]) [g.Imagen]
	var resultado [g.Imagen] = []
	repetir (cuadros) |img| resultado.agregar(espejo(img))
	resultado

