usar std/pincel/retro

// HUERTO — 320×180, celdas de 16×16. Todo el arte se genera con lienzo:
// sprites desde texto, árboles y casa con primitivas, y un suelo horneado
// que se repinta celda a celda al labrar, regar o romper piedras.
// WASD/flechas: caminar. Espacio o clic: usar. Q/E o rueda: herramienta.
// La puerta de la casa duerme, la caja vende la cosecha y el puesto
// vende semillas. H: ayuda.

const ancho = 320
const alto = 180
const lado = 16
const mapa_ancho = 640
const mapa_alto = 448
const alcance = 26.0

