	"o": color.rgba(26, 28, 44),
	"p": color.rgba(93, 39, 93),
	"r": color.rgba(177, 62, 83),
	"n": color.rgba(239, 125, 87),
	"N": color.rgba(190, 84, 52),
	"y": color.rgba(255, 205, 117),
	"l": color.rgba(167, 240, 112),
	"g": color.rgba(56, 183, 100),
	"G": color.rgba(37, 113, 121),
	"u": color.rgba(41, 54, 111),
	"b": color.rgba(59, 93, 201),
	"c": color.rgba(65, 166, 246),
	"w": color.rgba(244, 244, 244),
	"s": color.rgba(148, 176, 194),
	"S": color.rgba(86, 108, 134),
	"d": color.rgba(51, 60, 87),
	"t": color.rgba(143, 86, 59),
	"T": color.rgba(92, 58, 42),
	"m": color.rgba(194, 138, 88),
	"k": color.rgba(232, 183, 150),
]

fn tono(clave cadena) color.Color
	colores[clave] o .Negro

