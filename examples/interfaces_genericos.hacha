// Las interfaces se implementan por sus métodos, sin una declaración adicional.
interfaz Describible
	fn describir() cadena

// Una interfaz vacía puede guardar cualquier valor de Hacha.
interfaz Cualquiera

tipo Dato
	id num

tipo Usuario
	nombre cadena
	fn describir() cadena @nombre

tipo Caja<T>
	valor T
	fn obtener() T @valor

interfaz Proveedor<T>
	fn obtener() T

enum Evento<T>
	Vacio
	Dato T

fn identidad<T>(valor T) T valor

fn describir<T Describible>(valor T) cadena valor.describir()

fn leer<T>(fuente Proveedor<T>) T fuente.obtener()

fn inicio()
	var usuario = Usuario {nombre: "Ana"}
	var caja = Caja<Usuario> {valor: usuario}
	imprimir(describir(caja.obtener()))
	// T no se infiere desde los métodos de Caja: se escribe explícitamente.
	imprimir(leer<Usuario>(caja).nombre)
	imprimir(identidad(42))

	var evento Evento<Usuario> = .Dato(usuario)
	casos evento |dato|
		.Dato => imprimir(dato.nombre)
		.Vacio => imprimir("sin dato")

	var valores [Cualquiera] = [usuario, 7, "hola"]
	repetir (valores) |valor|
		casos valor |dato|
			Describible => imprimir(dato.describir())
			num => imprimir(dato)
			_ => imprimir("otro valor")

	var valor Cualquiera = usuario
	si valor como Usuario |dato|
		dato.nombre = "Luis"
	imprimir(usuario.nombre)
