usar modelos como m
usar interno/herramientas

fn mostrar<T m.Describible>(valor T)
	imprimir(valor.describir())

fn inicio()
	var usuario = herramientas.crear()
	var caja = m.Caja<m.Usuario> {valor: usuario}
	mostrar(caja.obtener())
	var evento = m.Evento.Usuario(usuario)
	casos evento |dato|
		m.Evento.Usuario => imprimir(dato.nombre)
		m.Evento.Vacio => imprimir("sin usuario")
	imprimir(herramientas.identidad<num>(42))
