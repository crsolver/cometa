// Pincel: movimiento. Una pelota que rebota en los bordes.
usar std/mate
usar std/pincel
usar std/pincel/graficos

const ancho entero = 320
const alto entero = 180
const radio decimal = 10

tipo Pelota
	pos mate.Vec2
	vel mate.Vec2   // píxeles por segundo

	pub fn actualizar(dt decimal)
		// Multiplicar por dt hace que la velocidad no dependa de los FPS.
		@pos = @pos + @vel * dt

		// Si toca un borde, invierte la dirección.
		si @pos.x < radio || @pos.x > ancho - radio
			@vel.x = -@vel.x
		si @pos.y < radio || @pos.y > alto - radio
			@vel.y = -@vel.y

	pub fn pintar()
		graficos.limpiar(.Indigo)
		graficos.circulo_v(@pos, radio, .Rosa)

fn inicio()
	var pelota = Pelota {pos: {x: 160, y: 90}, vel: {x: 120, y: 80}}
	pincel.ejecutar(pelota, ancho, alto, titulo = "Rebote", escala = 3) atrapar |error|
		imprimir(error)
