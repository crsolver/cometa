usar std/mate
usar std/azar
usar std/pincel/juego
usar std/pincel/graficos
usar std/pincel/color
usar std/pincel/entrada

// Sobrevivientes: un "vampire survivors" minimalista escrito en Cometa.
// Sin sprites: todo se dibuja con primitivas (círculos y rectángulos).
// Controles: WASD o flechas para moverse. El personaje dispara solo
// al enemigo más cercano. Recoge los orbes azules para subir de nivel.

tipo Enemigo
	pos mate.Vec2
	vida entero
	velocidad decimal
	radio decimal

tipo Proyectil
	pos mate.Vec2
	direccion mate.Vec2
	velocidad decimal
	vida decimal
	radio decimal
	dano entero

tipo Orbe
	pos mate.Vec2
	valor entero
	radio decimal

var jugador_pos = mate.Vec2 {x: 0, y: 0}
var jugador_vida = 100
var jugador_vida_max = 100
var jugador_velocidad = 140.0
var jugador_radio = 10.0
var jugador_nivel = 1
var jugador_experiencia = 0
var jugador_experiencia_siguiente = 10

var enemigos [Enemigo] = []
var proyectiles [Proyectil] = []
var orbes [Orbe] = []

var tiempo_disparo = 0.0
var intervalo_disparo = 0.5
var tiempo_spawn = 0.0
var intervalo_spawn = 1.0
var tiempo_transcurrido = 0.0
var juego_terminado = falso

fn iniciar() retornar
// --- movimiento del jugador -------------------------------------------------

fn mover_jugador(dt decimal)
	var dx = 0.0
	var dy = 0.0
	si entrada.tecla_mantenida(.W)
		dy = dy - 1
	si entrada.tecla_mantenida(.Arriba)
		dy = dy - 1
	si entrada.tecla_mantenida(.S)
		dy = dy + 1
	si entrada.tecla_mantenida(.Abajo)
		dy = dy + 1
	si entrada.tecla_mantenida(.A)
		dx = dx - 1
	si entrada.tecla_mantenida(.Izquierda)
		dx = dx - 1
	si entrada.tecla_mantenida(.D)
		dx = dx + 1
	si entrada.tecla_mantenida(.Derecha)
		dx = dx + 1

	var direccion = mate.Vec2 {x: dx, y: dy}
	si direccion.longitud() > 0
		direccion = direccion.normalizado()
		jugador_pos = jugador_pos + direccion * (jugador_velocidad * dt)



// --- generación de enemigos --------------------------------------------------
fn actualizar_spawn(dt decimal)
	tiempo_spawn = tiempo_spawn + dt
	var intervalo = intervalo_spawn - (tiempo_transcurrido * 0.01)
	si intervalo < 0.15
		intervalo = 0.15
	si tiempo_spawn >= intervalo
		tiempo_spawn = 0
		spawnear_enemigo()


fn spawnear_enemigo()
	var angulo = azar.real(0, mate.pi * 2)
	var distancia = 480.0
	var pos = mate.Vec2 {
		x: jugador_pos.x + mate.coseno(angulo) * distancia,
		y: jugador_pos.y + mate.seno(angulo) * distancia
	}
	var vida_base = 3 + mate.piso(tiempo_transcurrido / 10.0)
	var enemigo = Enemigo {pos: pos, vida: vida_base, velocidad: 60.0, radio: 12.0}
	enemigos.agregar(enemigo)


fn actualizar_enemigos(dt decimal)
	repetir (enemigos) |enemigo|
		var direccion = jugador_pos - enemigo.pos
		si direccion.longitud() > 0
			direccion = direccion.normalizado()
		enemigo.pos = enemigo.pos + direccion * (enemigo.velocidad * dt)



// --- disparo automático -------------------------------------------------------
fn actualizar_disparo(dt decimal)
	tiempo_disparo = tiempo_disparo + dt
	si tiempo_disparo >= intervalo_disparo
		tiempo_disparo = 0
		disparar_al_mas_cercano()


fn disparar_al_mas_cercano()
	si enemigos.esta_vacia()
		retornar

	var indice_cercano = 0
	var distancia_cercana = jugador_pos.distancia_a(enemigos[0].pos)
	repetir (enemigos) |enemigo, indice|
		var distancia = jugador_pos.distancia_a(enemigo.pos)
		si distancia < distancia_cercana
			distancia_cercana = distancia
			indice_cercano = indice

	var objetivo = enemigos[indice_cercano]
	var direccion = objetivo.pos - jugador_pos
	si direccion.longitud() > 0
		direccion = direccion.normalizado()

	var proyectil = Proyectil {
		pos: jugador_pos,
		direccion: direccion,
		velocidad: 320.0,
		vida: 2.0,
		radio: 4.0,
		dano: 1
	}
	proyectiles.agregar(proyectil)


fn actualizar_proyectiles(dt decimal)
	var indice = 0
	repetir
		si indice >= proyectiles.longitud()
			romper
		var proyectil = proyectiles[indice]
		proyectil.pos = proyectil.pos + proyectil.direccion * (proyectil.velocidad * dt)
		proyectil.vida = proyectil.vida - dt
		si proyectil.vida <= 0
			proyectiles.eliminar(indice)
		sino
			indice = indice + 1

// --- orbes de experiencia ------------------------------------------------------

fn generar_orbe(pos mate.Vec2)
	var orbe = Orbe {pos: pos, valor: 1, radio: 5.0}
	orbes.agregar(orbe)

fn actualizar_orbes(dt decimal)
	repetir (orbes) |orbe|
		var distancia = jugador_pos.distancia_a(orbe.pos)
		si distancia < 90.0
			var direccion = jugador_pos - orbe.pos
			si direccion.longitud() > 0
				direccion = direccion.normalizado()
			orbe.pos = orbe.pos + direccion * (420.0 * dt)

fn subir_nivel()
	jugador_nivel = jugador_nivel + 1
	jugador_experiencia = jugador_experiencia - jugador_experiencia_siguiente
	jugador_experiencia_siguiente = jugador_experiencia_siguiente + 5
	intervalo_disparo = intervalo_disparo - 0.03
	si intervalo_disparo < 0.1
		intervalo_disparo = 0.1

// --- colisiones -----------------------------------------------------------------

fn comprobar_colisiones()
	comprobar_colision_proyectiles_enemigos()
	comprobar_colision_jugador_enemigos()
	comprobar_colision_jugador_orbes()

fn comprobar_colision_proyectiles_enemigos()
	var indice_proyectil = 0
	repetir
		si indice_proyectil >= proyectiles.longitud()
			romper
		var proyectil = proyectiles[indice_proyectil]
		var impacto = falso
		var indice_enemigo = 0
		repetir
			si indice_enemigo >= enemigos.longitud()
				romper
			var enemigo = enemigos[indice_enemigo]
			si proyectil.pos.colision_circulo(proyectil.radio, enemigo.pos, enemigo.radio)
				enemigo.vida = enemigo.vida - proyectil.dano
				impacto = verdadero
				si enemigo.vida <= 0
					generar_orbe(enemigo.pos)
					enemigos.eliminar(indice_enemigo)
				romper
			indice_enemigo = indice_enemigo + 1
		si impacto
			proyectiles.eliminar(indice_proyectil)
		sino
			indice_proyectil = indice_proyectil + 1

fn comprobar_colision_jugador_enemigos()
	var indice = 0
	repetir
		si indice >= enemigos.longitud()
			romper
		var enemigo = enemigos[indice]
		si jugador_pos.colision_circulo(jugador_radio, enemigo.pos, enemigo.radio)
			jugador_vida = jugador_vida - 1
			enemigos.eliminar(indice)
		sino
			indice = indice + 1

fn comprobar_colision_jugador_orbes()
	var indice = 0
	repetir
		si indice >= orbes.longitud()
			romper
		var orbe = orbes[indice]
		si jugador_pos.colision_circulo(jugador_radio + 20.0, orbe.pos, orbe.radio)
			jugador_experiencia = jugador_experiencia + orbe.valor
			orbes.eliminar(indice)
			si jugador_experiencia >= jugador_experiencia_siguiente
				subir_nivel()
		sino
			indice = indice + 1

// --- dibujo -----------------------------------------------------------------------

fn dibujar_mundo()
	var espaciado = 60.0
	var columna_inicio = mate.piso((jugador_pos.x - 450.0) / espaciado)
	var columna_fin = mate.piso((jugador_pos.x + 450.0) / espaciado)
	var fila_inicio = mate.piso((jugador_pos.y - 350.0) / espaciado)
	var fila_fin = mate.piso((jugador_pos.y + 350.0) / espaciado)
	repetir (columna_inicio..(columna_fin + 1)) |columna|
		repetir (fila_inicio..(fila_fin + 1)) |fila|
			var x = columna * espaciado
			var y = fila * espaciado
			graficos.circulo(x, y, 2.0, color.rgba(60, 60, 80, 255))

fn dibujar_jugador()
	graficos.circulo_v(jugador_pos, jugador_radio, color.rgba(80, 200, 255, 255))

	var barra_pos = mate.Vec2 {x: jugador_pos.x - 20, y: jugador_pos.y - 25}
	graficos.rectangulo_v(barra_pos, mate.Vec2 {x: 40, y: 5}, color.rgba(60, 20, 20, 255))
	var proporcion = jugador_vida / jugador_vida_max
	graficos.rectangulo_v(barra_pos, mate.Vec2 {x: 40 * proporcion, y: 5}, color.rgba(80, 220, 80, 255))

fn dibujar_enemigos()
	repetir (enemigos) |enemigo|
		graficos.circulo_v(enemigo.pos, enemigo.radio, color.rgba(220, 60, 60, 255))

fn dibujar_proyectiles()
	repetir (proyectiles) |proyectil|
		graficos.circulo_v(proyectil.pos, proyectil.radio, color.rgba(255, 240, 120, 255))

fn dibujar_orbes()
	repetir (orbes) |orbe|
		graficos.circulo_v(orbe.pos, orbe.radio, color.rgba(140, 220, 255, 255))

fn dibujar_ui()
	graficos.texto_depuracion("Vida: ${jugador_vida}/${jugador_vida_max}", 10, 10)
	graficos.texto_depuracion("Nivel: ${jugador_nivel}", 10, 25)
	graficos.texto_depuracion("Experiencia: ${jugador_experiencia}/${jugador_experiencia_siguiente}", 10, 40)
	graficos.texto_depuracion("Enemigos: ${enemigos.longitud()}", 10, 55)
	graficos.texto_depuracion("Tiempo: ${mate.piso(tiempo_transcurrido)}s", 10, 70)
	si juego_terminado
		graficos.texto_depuracion("HAS MUERTO -- presiona Enter para reiniciar", 250, 290)

// --- reinicio ----------------------------------------------------------------------

fn reiniciar()
	jugador_pos = {0, 0}
	jugador_vida = jugador_vida_max
	jugador_nivel = 1
	jugador_experiencia = 0
	jugador_experiencia_siguiente = 10
	intervalo_disparo = 0.5
	tiempo_transcurrido = 0
	tiempo_spawn = 0
	tiempo_disparo = 0
	enemigos = []
	proyectiles = []
	orbes = []
	juego_terminado = falso

tipo Partida
	pub fn actualizar(dt decimal)
		si juego_terminado
			si entrada.tecla_presionada(.Enter)
				reiniciar()
			retornar
	
		tiempo_transcurrido = tiempo_transcurrido + dt
		mover_jugador(dt)
		actualizar_spawn(dt)
		actualizar_enemigos(dt)
		actualizar_disparo(dt)
		actualizar_proyectiles(dt)
		actualizar_orbes(dt)
		comprobar_colisiones()
	
		si jugador_vida <= 0
			juego_terminado = verdadero

	pub fn pintar()
		graficos.limpiar(color.rgba(18, 18, 26, 255))
	
		graficos.usar_camara({
			pos: jugador_pos, 
			origen: {400, 300}, 
			zoom: 1, 
			rotacion: 0
		})
	
		dibujar_mundo()
		dibujar_orbes()
		dibujar_enemigos()
		dibujar_proyectiles()
		dibujar_jugador()
		graficos.restablecer_camara()
	
		dibujar_ui()

fn inicio()
	iniciar()
	juego.ejecutar(Partida {}, 800, 600, titulo = "Sobrevivientes", escala = 1) capturar |error|
		imprimir(error)
