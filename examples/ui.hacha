usar std/pincel/juego
usar std/pincel/graficos
usar std/pincel/ui

tipo Opciones
	contexto ui.Contexto
	volumen decimal
	musica bool
	aceptado bool

	fn actualizar(dt decimal)
		con ui.cuadro(@contexto)
			con ui.panel("opciones", ancho = ui.fijo(280), alto = ui.fijo(160), relleno = {8, 8, 8, 8}, espacio = 8, desplazar = verdadero)
				ui.texto("Opciones de Pincel")
				@musica = ui.casilla("musica", @musica, "Música")
				ui.texto("Volumen ${@volumen}")
				@volumen = ui.deslizador("volumen", @volumen, ancho = ui.expandir())
				con ui.fila("acciones", ancho = ui.expandir(), espacio = 8)
					si ui.boton("aceptar", "Aceptar", ancho = ui.expandir())
						@aceptado = verdadero
					si ui.boton("reiniciar", "Reiniciar", ancho = ui.expandir())
						@volumen = 0.5
						@aceptado = falso
				ui.texto("Tab: foco. Enter: activar. Flechas: volumen. Rueda: desplazar.", ancho = ui.expandir())
				si @aceptado
					ui.texto("¡Opciones guardadas!")


	fn pintar()
		graficos.limpiar(.Negro)
		ui.pintar(@contexto)


fn inicio()
	var opciones = Opciones {contexto: ui.crear(), volumen: 0.5, musica: verdadero}
	juego.ejecutar(opciones, 320, 180, titulo = "Pincel UI", escala = 3, pixelado = verdadero) capturar |error|
		imprimir(error)
