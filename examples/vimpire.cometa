usar std/mate
usar std/pincel/juego
usar std/pincel/graficos
usar std/pincel/recursos

var fuente = recursos.fuente("assets/dungeonmode/font/dungeon-mode.ttf")
var glifos = recursos.imagen("assets/dungeonmode/bitmap/dungeon-mode.png")

const ancho_glifo entero = 8
const alto_glifo entero = 8
const columnas entero = 16


fn iniciar() retornar
	//juego.configuracion(180, 180, titulo = "Cometa: recoge el objetivo", escala = 4)


fn region_glifo(codigo entero) mate.Rect
	var columna = codigo % columnas
	var fila = codigo / columnas
	mate.Rect {
		pos: {x: columna * ancho_glifo, y: fila * alto_glifo},
		tamano: {x: ancho_glifo, y: alto_glifo}
	}


fn dibujar_glifo(codigo entero, x decimal, y decimal, escala decimal = 1)
	graficos.region(
		glifos, 
		region_glifo(codigo), 
		x, 
		y, 
		escala = {x: escala, y: escala}
	)

tipo Partida
	pub fn actualizar(dt decimal) retornar

	pub fn pintar()
		graficos.texto("3 1 @ you take -1 dmg!", fuente, 1, 1, tamano = 20)
		//dibujar_glifo(2, x=10, y=10)
		//dibujar_glifo(3, x=20, y=10)

fn inicio()
	iniciar()
	juego.ejecutar(Partida {}) capturar |error|
		imprimir(error)
