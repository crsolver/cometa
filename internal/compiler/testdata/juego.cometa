usar std/mate
usar std/pincel
usar std/pincel/graficos

tipo Jugador
	pos mate.Vec2
	vel mate.Vec2

var jugador = Jugador {}

tipo Partida
	pub fn actualizar(dt decimal)
		jugador.pos = jugador.pos + jugador.vel * dt

	pub fn pintar()
		graficos.rectangulo_v(jugador.pos, mate.Vec2 {x: 10, y: 10}, .Rojo)

fn inicio()
	pincel.ejecutar(Partida {}) atrapar |error|
		imprimir(error)
