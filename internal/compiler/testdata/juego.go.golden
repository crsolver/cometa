	"unicode"
)

type _hgVec2 struct{ X, Y float64 }
type _hgRect struct{ Pos, Tamano _hgVec2 }
type _hgCamara2D struct {
	Pos, Origen    _hgVec2
	Zoom, Rotacion float64
}
type _hgConfigJuego struct {
	Ancho, Alto                        int64
	Titulo                             string
	Escala                             float64
	Redimensionable, Pantalla_completa bool
	Tps                                int64
}
type _hgColor = color.NRGBA
type _hgImagen struct {
	image  *ebiten.Image
	pixels *image.NRGBA
	dirty  bool
}
type _hgFuente struct{ source *text.GoTextFaceSource }
type _hgSonido struct{ pcm []byte }
type _hgReproduccion struct {
	player       *audio.Player
	sound        *_hgSonido
	loop, paused bool
	volume       float64
}
type _hgJuego interface {
	Actualizar(float64)
	Pintar()
	_cometa_public_Actualizar()
	_cometa_public_Pintar()
}
type _hgGame struct{ instancia _hgJuego }

var _hgconfig = _hgConfigJuego{320, 180, "Cometa", 1, false, false, 60}
var _hgrunStarted bool
var _hgscreen *ebiten.Image
var _hgcamara = _hgCamara2D{Zoom: 1}
var _hgplayers = map[*_hgReproduccion]bool{}
var _hgwhite *ebiten.Image
var _hgupdating bool
var _hgsalirPedido bool

func _hgsalir() { _hgsalirPedido = true }

var _hgtick uint64

func (g *_hgGame) Update() error {
	if _hgcapturaHecha {
		return ebiten.Termination
	}
	_hgtick++
	_hgupdating = true
	defer func() { _hgupdating = false }()
	g.instancia.Actualizar(1 / float64(_hgconfig.Tps))
	if _hgsalirPedido {
		return ebiten.Termination
	}
	for r := range _hgplayers {
		if !r.paused && !r.player.IsPlaying() {
			r.player.Close()
			r.player = nil
			delete(_hgplayers, r)
		}
	}
	return nil
}
func (g *_hgGame) Draw(screen *ebiten.Image) {
	_hgscreen = screen
	_hgsinRecorte = nil
	_hgrestablecerCamara()
	defer func() { _hgscreen = nil }()
	g.instancia.Pintar()
	_hgcapturar(screen)
}
func (*_hgGame) Layout(w, h int) (int, int) { return int(_hgconfig.Ancho), int(_hgconfig.Alto) }
func _hgvalidarConfig(c _hgConfigJuego) error {
	for _, n := range []float64{float64(c.Ancho), float64(c.Alto), c.Escala, float64(c.Tps), float64(c.Ancho) * c.Escala, float64(c.Alto) * c.Escala} {
		if math.IsNaN(n) || math.IsInf(n, 0) || n <= 0 || n > 32768 {
			return fmt.Errorf("configuración de juego inválida: dimensiones, escala y tps deben ser positivos y finitos (máximo 32768)")
		}
	}
	if float64(c.Ancho)*c.Escala < 1 || float64(c.Alto)*c.Escala < 1 {
		return fmt.Errorf("las dimensiones de ventana deben ser al menos un píxel")
	}
	return nil
}
func _hgadd(a, b _hgVec2) _hgVec2           { return _hgVec2{a.X + b.X, a.Y + b.Y} }
func _hgsub(a, b _hgVec2) _hgVec2           { return _hgVec2{a.X - b.X, a.Y - b.Y} }
func _hgscale(a _hgVec2, s float64) _hgVec2 { return _hgVec2{a.X * s, a.Y * s} }
func _hglongitud(v _hgVec2) float64         { return math.Hypot(v.X, v.Y) }
func _hgnormalizar(v _hgVec2) _hgVec2 {
	n := _hglongitud(v)
	if n == 0 {
		return _hgVec2{}
	}
	return _hgscale(v, 1/n)
}
func _hgdistancia(a, b _hgVec2) float64     { return _hglongitud(_hgsub(a, b)) }
func _hgproductoPunto(a, b _hgVec2) float64 { return a.X*b.X + a.Y*b.Y }
func _hganguloVec(v _hgVec2) float64        { return math.Atan2(v.Y, v.X) }
func _hginterpolarVec(a, b _hgVec2, t float64) _hgVec2 {
	return _hgVec2{a.X + (b.X-a.X)*t, a.Y + (b.Y-a.Y)*t}
}
func _hgreflejar(v, n _hgVec2) _hgVec2 {
	n = _hgnormalizar(n)
	d := 2 * (v.X*n.X + v.Y*n.Y)
	return _hgVec2{v.X - d*n.X, v.Y - d*n.Y}
}
func _hgperpendicular(v _hgVec2) _hgVec2 { return _hgVec2{-v.Y, v.X} }
func _hgrotar(v _hgVec2, a float64) _hgVec2 {
	s, c := math.Sincos(a)
	return _hgVec2{v.X*c - v.Y*s, v.X*s + v.Y*c}
}
func _hgabs(v float64) float64              { return math.Abs(v) }
func _hgmin(a, b float64) float64           { return math.Min(a, b) }
func _hgmax(a, b float64) float64           { return math.Max(a, b) }
func _hglimitar(v, a, b float64) float64    { return math.Max(a, math.Min(b, v)) }
func _hginterpolar(a, b, t float64) float64 { return a + (b-a)*t }
func _hgpiso(v float64) int64               { return _hentero(math.Floor(v)) }
func _hgtecho(v float64) int64              { return _hentero(math.Ceil(v)) }
func _hgredondear(v float64) int64          { return _hentero(math.Round(v)) }
func _hgabsEntero(v int64) int64 {
	if v < 0 {
		return -v
	}
	return v
}
func _hgminEntero(a, b int64) int64 {
	if a < b {
		return a
	}
	return b
}
func _hgmaxEntero(a, b int64) int64 {
	if a > b {
		return a
	}
	return b
}
func _hglimitarEntero(v, a, b int64) int64 { return _hgmaxEntero(a, _hgminEntero(b, v)) }
func _hgraiz(v float64) float64            { return math.Sqrt(v) }
func _hgseno(v float64) float64            { return math.Sin(v) }
func _hgcoseno(v float64) float64          { return math.Cos(v) }
func _hgatan2(y, x float64) float64        { return math.Atan2(y, x) }
func _hgtangente(v float64) float64        { return math.Tan(v) }
func _hgpotencia(b, e float64) float64     { return math.Pow(b, e) }
func _hgsigno(v float64) float64 {
	if v > 0 {
		return 1
	}
	if v < 0 {
		return -1
	}
	return 0
}
func _hgsignoEntero(v int64) int64 {
	if v > 0 {
		return 1
	}
	if v < 0 {
		return -1
	}
	return 0
}
func _hgdistanciaXY(x1, y1, x2, y2 float64) float64 { return math.Hypot(x2-x1, y2-y1) }
func _hganguloXY(x1, y1, x2, y2 float64) float64    { return math.Atan2(y2-y1, x2-x1) }
func _hgradianes(g float64) float64                 { return g * math.Pi / 180 }
func _hggrados(r float64) float64                   { return r * 180 / math.Pi }
func _hgazarReal(a, b float64) float64 {
	if math.IsNaN(a) || math.IsNaN(b) || math.IsInf(a, 0) || math.IsInf(b, 0) || a > b || math.IsInf(b-a, 0) {
		panic("rango aleatorio inválido")
	}
	return a + _hgazarGen.Float64()*(b-a)
}
func _hgdraw() {
	if _hgscreen == nil {
		panic("dibujar solo se permite desde pintar")
	}
}
func _hgcameraMatrix() ebiten.GeoM {
	var m ebiten.GeoM
	m.Translate(-_hgcamara.Pos.X, -_hgcamara.Pos.Y)
	m.Rotate(-_hgcamara.Rotacion)
	m.Scale(_hgcamara.Zoom, _hgcamara.Zoom)
	m.Translate(_hgcamara.Origen.X, _hgcamara.Origen.Y)
	return m
}
func _hgpoint(v _hgVec2) _hgVec2 {
	m := _hgcameraMatrix()
	x, y := m.Apply(v.X, v.Y)
	return _hgVec2{x, y}
}
func _hglimpiar(c _hgColor) { _hgdraw(); _hgscreen.Fill(c) }
func _hgrectangulo(p, s _hgVec2, c _hgColor, o _hgVec2, r float64) {
	_hgdraw()
	if _hgcamara.Rotacion == 0 && r == 0 {
		p = _hgpoint(_hgsub(p, o))
		vector.FillRect(_hgscreen, float32(p.X), float32(p.Y), float32(s.X*_hgcamara.Zoom), float32(s.Y*_hgcamara.Zoom), c, false)
		return
	}
	if _hgwhite == nil {
		_hgwhite = ebiten.NewImage(1, 1)
		_hgwhite.Fill(color.White)
	}
	op := &ebiten.DrawImageOptions{}
	op.GeoM = _hgtransform(p, o, s, r, true)
	op.ColorScale.ScaleWithColor(c)
	_hgscreen.DrawImage(_hgwhite, op)
}
func _hgcirculo(p _hgVec2, r float64, c _hgColor) {
	_hgdraw()
	p = _hgpoint(p)
	vector.FillCircle(_hgscreen, float32(p.X), float32(p.Y), float32(r*_hgcamara.Zoom), c, true)
}
func _hglinea(a, b _hgVec2, c _hgColor, w float64) {
	_hgdraw()
	a = _hgpoint(a)
	b = _hgpoint(b)
	vector.StrokeLine(_hgscreen, float32(a.X), float32(a.Y), float32(b.X), float32(b.Y), float32(w*_hgcamara.Zoom), c, true)
}
func _hgpintarImagen(img *ebiten.Image, m ebiten.GeoM, c, f _hgColor) {
	if f.A == 0 {
		op := &ebiten.DrawImageOptions{}
		op.GeoM = m
		op.ColorScale.ScaleWithColor(c)
		_hgscreen.DrawImage(img, op)
		return
	}
	var cm colorm.ColorM
	cm.Scale(float64(c.R)/255, float64(c.G)/255, float64(c.B)/255, float64(c.A)/255)
	k := float64(f.A) / 255
	cm.Scale(1-k, 1-k, 1-k, 1)
	cm.Translate(k*float64(f.R)/255, k*float64(f.G)/255, k*float64(f.B)/255, 0)
	op := &colorm.DrawImageOptions{}
	op.GeoM = m
	colorm.DrawImage(_hgscreen, img, cm, op)
}
func _hgimageDraw(img *ebiten.Image, p, o, s _hgVec2, r float64, c, f _hgColor) {
	_hgdraw()
	_hgpintarImagen(img, _hgtransform(p, o, s, r, false), c, f)
}
func _hgimagen(img *_hgImagen, p, o, s _hgVec2, r float64, c, f _hgColor) {
	_hgimageDraw(img.gpu(), p, o, s, r, c, f)
}
func _hgregion(img *_hgImagen, region _hgRect, p, o, s _hgVec2, r float64, c, f _hgColor) {
	_hgdraw()
	area := image.Rect(int(region.Pos.X), int(region.Pos.Y), int(region.Pos.X+region.Tamano.X), int(region.Pos.Y+region.Tamano.Y))
	if area.Empty() {
		return
	}
	_hgimageDraw(img.gpu().SubImage(area).(*ebiten.Image), p, o, s, r, c, f)
}
func _hgtexto(value string, font *_hgFuente, p _hgVec2, size float64, c _hgColor, o _hgVec2, r float64) {
	_hgdraw()
	op := &text.DrawOptions{}
	op.GeoM = _hgtransform(p, o, _hgVec2{1, 1}, r, true)
	op.ColorScale.ScaleWithColor(c)
	op.LineSpacing = size * 1.2
	text.Draw(_hgscreen, value, &text.GoTextFace{Source: font.source, Size: size}, op)
}
func _hgmedirTexto(value string, font *_hgFuente, size float64) _hgVec2 {
	w, h := text.Measure(value, &text.GoTextFace{Source: font.source, Size: size}, size*1.2)
	return _hgVec2{w, h}
}
func _hgtextoDepuracion(value string, p _hgVec2) {
	_hgdraw()
	ebitenutil.DebugPrintAt(_hgscreen, value, int(p.X), int(p.Y))
}
func _hgtamano() _hgVec2 { return _hgVec2{float64(_hgconfig.Ancho), float64(_hgconfig.Alto)} }
func _hgusarCamara(c _hgCamara2D) {
	_hgdraw()
	if c.Zoom <= 0 || math.IsNaN(c.Zoom) || math.IsInf(c.Zoom, 0) {
		panic("zoom debe ser positivo y finito")
	}
	_hgcamara = c
}
func _hgrestablecerCamara() { _hgdraw(); _hgcamara = _hgCamara2D{Zoom: 1} }
func _hgrectangulos(a, b _hgRect) bool {
	return a.Pos.X < b.Pos.X+b.Tamano.X && a.Pos.X+a.Tamano.X > b.Pos.X && a.Pos.Y < b.Pos.Y+b.Tamano.Y && a.Pos.Y+a.Tamano.Y > b.Pos.Y
}
func _hgcirculos(a _hgVec2, ra float64, b _hgVec2, rb float64) bool {
	return _hgdistancia(a, b) <= ra+rb
}
func _hgcentroRect(r _hgRect) _hgVec2 { return _hgVec2{r.Pos.X + r.Tamano.X/2, r.Pos.Y + r.Tamano.Y/2} }
func _hginterseccionRect(a, b _hgRect) _hgRect {
	x1 := math.Max(a.Pos.X, b.Pos.X)
	y1 := math.Max(a.Pos.Y, b.Pos.Y)
	x2 := math.Min(a.Pos.X+a.Tamano.X, b.Pos.X+b.Tamano.X)
	y2 := math.Min(a.Pos.Y+a.Tamano.Y, b.Pos.Y+b.Tamano.Y)
	if x2 <= x1 || y2 <= y1 {
		return _hgRect{}
	}
	return _hgRect{_hgVec2{x1, y1}, _hgVec2{x2 - x1, y2 - y1}}
}
func _hgdesplazadoRect(r _hgRect, d _hgVec2) _hgRect {
	return _hgRect{_hgVec2{r.Pos.X + d.X, r.Pos.Y + d.Y}, r.Tamano}
}
func _hgcirculoRect(r _hgRect, c _hgVec2, radio float64) bool {
	nx := math.Max(r.Pos.X, math.Min(c.X, r.Pos.X+r.Tamano.X))
	ny := math.Max(r.Pos.Y, math.Min(c.Y, r.Pos.Y+r.Tamano.Y))
	return math.Hypot(c.X-nx, c.Y-ny) <= radio
}
func _hgpuntoRectangulo(p _hgVec2, r _hgRect) bool {
	return p.X >= r.Pos.X && p.Y >= r.Pos.Y && p.X < r.Pos.X+r.Tamano.X && p.Y < r.Pos.Y+r.Tamano.Y
}

var _hgfuenteGo *_hgFuente

func _hgfuentePredeterminada() *_hgFuente {
	if _hgfuenteGo == nil {
		f, err := text.NewGoTextFaceSource(bytes.NewReader(goregular.TTF))
		if err != nil {
			log.Fatalf("fuente predeterminada: %v", err)
		}
		_hgfuenteGo = &_hgFuente{f}
	}
	return _hgfuenteGo
}
func (v _hgVec2) Longitud() float64                   { return _hglongitud(v) }
func (v _hgVec2) Normalizado() _hgVec2                { return _hgnormalizar(v) }
func (v _hgVec2) Distancia_a(otro _hgVec2) float64    { return _hgdistancia(v, otro) }
func (v _hgVec2) Producto_punto(otro _hgVec2) float64 { return _hgproductoPunto(v, otro) }
func (v _hgVec2) Rotado(angulo float64) _hgVec2       { return _hgrotar(v, angulo) }
func (v _hgVec2) Colision_circulo(radio float64, otro _hgVec2, radioOtro float64) bool {
	return _hgcirculos(v, radio, otro, radioOtro)
}
func (v _hgVec2) Angulo() float64                            { return _hganguloVec(v) }
func (v _hgVec2) Interpolar(otro _hgVec2, t float64) _hgVec2 { return _hginterpolarVec(v, otro, t) }
func (v _hgVec2) Reflejar(normal _hgVec2) _hgVec2            { return _hgreflejar(v, normal) }
func (v _hgVec2) Perpendicular() _hgVec2                     { return _hgperpendicular(v) }
func (r _hgRect) Centro() _hgVec2                            { return _hgcentroRect(r) }
func (r _hgRect) Interseccion(otro _hgRect) _hgRect          { return _hginterseccionRect(r, otro) }
func (r _hgRect) Desplazado(delta _hgVec2) _hgRect           { return _hgdesplazadoRect(r, delta) }
func (r _hgRect) Colision_circulo(centro _hgVec2, radio float64) bool {
	return _hgcirculoRect(r, centro, radio)
}
func (r _hgRect) Interseca(otro _hgRect) bool { return _hgrectangulos(r, otro) }
func (r _hgRect) Contiene(punto _hgVec2) bool { return _hgpuntoRectangulo(punto, r) }
func _hgrectanguloXY(x, y, w, h float64, c _hgColor, o _hgVec2, r float64) {
	_hgrectangulo(_hgVec2{x, y}, _hgVec2{w, h}, c, o, r)
}
func _hgrectanguloRect(rect _hgRect, c _hgColor, o _hgVec2, r float64) {
	_hgrectangulo(rect.Pos, rect.Tamano, c, o, r)
}
func _hgcirculoXY(x, y, r float64, c _hgColor) { _hgcirculo(_hgVec2{x, y}, r, c) }
func _hglineaXY(x1, y1, x2, y2 float64, c _hgColor, w float64) {
	_hglinea(_hgVec2{x1, y1}, _hgVec2{x2, y2}, c, w)
}
func _hgimagenXY(img *_hgImagen, x, y float64, o, s _hgVec2, r float64, c, f _hgColor) {
	_hgimagen(img, _hgVec2{x, y}, o, s, r, c, f)
}
func _hgregionXY(img *_hgImagen, region _hgRect, x, y float64, o, s _hgVec2, r float64, c, f _hgColor) {
	_hgregion(img, region, _hgVec2{x, y}, o, s, r, c, f)
}
func _hgtextoXY(v string, f *_hgFuente, x, y, size float64, c _hgColor, o _hgVec2, r float64) {
	_hgtexto(v, f, _hgVec2{x, y}, size, c, o, r)
}
func _hgtextoDepuracionXY(v string, x, y float64) { _hgtextoDepuracion(v, _hgVec2{x, y}) }
func _hgimageRect(img *ebiten.Image, d _hgRect, o _hgVec2, r float64, c, f _hgColor) {
	_hgdraw()
	bounds := img.Bounds()
	if bounds.Empty() {
		return
	}
	_hgpintarImagen(img, _hgtransform(d.Pos, o, _hgVec2{d.Tamano.X / float64(bounds.Dx()), d.Tamano.Y / float64(bounds.Dy())}, r, true), c, f)
}
func _hgimagenRect(img *_hgImagen, d _hgRect, o _hgVec2, r float64, c, f _hgColor) {
	_hgimageRect(img.gpu(), d, o, r, c, f)
}
func _hgregionRect(img *_hgImagen, source, d _hgRect, o _hgVec2, r float64, c, f _hgColor) {
	_hgdraw()
	area := image.Rect(int(source.Pos.X), int(source.Pos.Y), int(source.Pos.X+source.Tamano.X), int(source.Pos.Y+source.Tamano.Y))
	if area.Empty() {
		return
	}
	_hgimageRect(img.gpu().SubImage(area).(*ebiten.Image), d, o, r, c, f)
}

var _hgsinRecorte *ebiten.Image

func _hgrecortar(r _hgRect) {
	_hgdraw()
	if _hgsinRecorte == nil {
		_hgsinRecorte = _hgscreen
	}
	area := image.Rect(int(math.Floor(r.Pos.X)), int(math.Floor(r.Pos.Y)), int(math.Ceil(r.Pos.X+r.Tamano.X)), int(math.Ceil(r.Pos.Y+r.Tamano.Y))).Intersect(_hgsinRecorte.Bounds())
	_hgscreen = _hgsinRecorte.SubImage(area).(*ebiten.Image)
}
func _hgquitarRecorte() {
	_hgdraw()
	if _hgsinRecorte != nil {
		_hgscreen = _hgsinRecorte
		_hgsinRecorte = nil
	}
}
func _hgtransform(p, o, s _hgVec2, r float64, destinationOrigin bool) ebiten.GeoM {
	var m ebiten.GeoM
	if !destinationOrigin {
		m.Translate(-o.X, -o.Y)
	}
	m.Scale(s.X, s.Y)
	if destinationOrigin {
		m.Translate(-o.X, -o.Y)
	}
	m.Rotate(r)
	m.Translate(p.X, p.Y)
	m.Concat(_hgcameraMatrix())
	return m
}
func _hgejecutar(instancia _hgJuego, w, h int64, title string, scale float64, resize, full bool, tps int64, pixelado, retro bool) struct {
	tag      int
	payload2 string
} {
	fail := func(err error) struct {
		tag      int
		payload2 string
	} {
		return struct {
			tag      int
			payload2 string
		}{2, err.Error()}
	}
	config := _hgConfigJuego{w, h, title, scale, resize, full, tps}
	if err := _hgvalidarConfig(config); err != nil {
		return fail(err)
	}
	if _hgrunStarted {
		return fail(fmt.Errorf("Pincel solo permite ejecutar un juego una vez por proceso"))
	}
	var game ebiten.Game = &_hgGame{instancia: instancia}
	if retro {
		shader, err := ebiten.NewShader([]byte(_hgCRTSource))
		if err != nil {
			return fail(fmt.Errorf("no se pudo inicializar el efecto CRT: %w", err))
		}
		defer shader.Dispose()
		game = &_hgCRTGame{Game: game, shader: shader}
	}
	_hgrunStarted = true
	_hgconfig = config
	ebiten.SetWindowSize(int(float64(w)*scale), int(float64(h)*scale))
	ebiten.SetWindowTitle(title)
	ebiten.SetFullscreen(full)
	if resize {
		ebiten.SetWindowResizingMode(ebiten.WindowResizingModeEnabled)
	}
	ebiten.SetTPS(int(tps))
	ebiten.SetScreenFilterEnabled(!(pixelado || retro))
	if _hgcapturaRuta != "" {
		ebiten.SetWindowVisible(false)
		ebiten.SetRunnableOnUnfocused(true)
	}
	if err := ebiten.RunGame(game); err != nil {
		return fail(err)
	}
	return struct {
		tag      int
		payload2 string
	}{1, ""}
}
func (i *_hgImagen) gpu() *ebiten.Image {
	if i.image == nil {
		i.image = ebiten.NewImageFromImage(i.pixels)
		i.dirty = false
	}
	if i.dirty {
		i.image.WritePixels(_hgpremultiplicar(i.pixels.Pix))
		i.dirty = false
	}
	return i.image
}
func (i *_hgImagen) bounds() image.Rectangle {
	if i.pixels != nil {
		return i.pixels.Rect
	}
	return i.image.Bounds()
}
func _hgpremultiplicar(pix []byte) []byte {
	out := make([]byte, len(pix))
	for i := 0; i < len(pix); i += 4 {
		a := uint32(pix[i+3])
		out[i] = uint8(uint32(pix[i]) * a / 255)
		out[i+1] = uint8(uint32(pix[i+1]) * a / 255)
		out[i+2] = uint8(uint32(pix[i+2]) * a / 255)
		out[i+3] = pix[i+3]
	}
	return out
}

