}
func (c _hgCamara2D) zoom() float64 {
	if !(c.Zoom > 0) || math.IsInf(c.Zoom, 0) {
		panic("zoom debe ser positivo y finito")
	}
	return c.Zoom
}
func (c _hgCamara2D) A_mundo(p _hgVec2) _hgVec2 {
	return _hgadd(_hgrotar(_hgscale(_hgsub(p, c.Origen), 1/c.zoom()), c.Rotacion), c.Pos)
}
func (c _hgCamara2D) A_pantalla(p _hgVec2) _hgVec2 {
	return _hgadd(_hgscale(_hgrotar(_hgsub(p, c.Pos), -c.Rotacion), c.zoom()), c.Origen)
}
func (c _hgCamara2D) Siguiendo(objetivo _hgVec2, suavizado float64) _hgCamara2D {
	if math.IsNaN(suavizado) {
		panic("suavizado inválido")
	}
	c.Pos = _hgadd(c.Pos, _hgscale(_hgsub(objetivo, c.Pos), _hglimitar(suavizado, 0, 1)))
	return c
}
func (c _hgCamara2D) Visible() _hgRect {
	s := _hgtamano()
	x0, y0, x1, y1 := math.Inf(1), math.Inf(1), math.Inf(-1), math.Inf(-1)
	for _, q := range []_hgVec2{{0, 0}, {s.X, 0}, {0, s.Y}, {s.X, s.Y}} {
		p := c.A_mundo(q)
		x0, y0, x1, y1 = math.Min(x0, p.X), math.Min(y0, p.Y), math.Max(x1, p.X), math.Max(y1, p.Y)
	}
	return _hgRect{_hgVec2{x0, y0}, _hgVec2{x1 - x0, y1 - y0}}
}
func (c _hgCamara2D) Limitada(mundo _hgRect) _hgCamara2D {
	z, s := c.zoom(), _hgtamano()
	eje := func(pos, origen, pantalla, inicio, largo float64) float64 {
		ancho := pantalla / z
		izq := pos - origen/z
		if ancho >= largo {
			izq = inicio + (largo-ancho)/2
		} else {
			izq = _hglimitar(izq, inicio, inicio+largo-ancho)
		}
		return izq + origen/z
	}
	c.Pos = _hgVec2{eje(c.Pos.X, c.Origen.X, s.X, mundo.Pos.X, mundo.Tamano.X), eje(c.Pos.Y, c.Origen.Y, s.Y, mundo.Pos.Y, mundo.Tamano.Y)}
	return c
}
func (c _hgCamara2D) Sacudida(intensidad float64) _hgCamara2D {
	if !(intensidad > 0) || math.IsInf(intensidad, 0) {
		return c
	}
	c.Pos = _hgadd(c.Pos, _hgVec2{_hgazarReal(-intensidad, intensidad), _hgazarReal(-intensidad, intensidad)})
	return c
}
func _hgescribirPNG(src image.Image, ruta string, escala int64) error {
	if escala <= 0 || escala > 64 {
		return fmt.Errorf("la escala debe estar entre 1 y 64")
	}
	b := src.Bounds()
	out := image.NewNRGBA(image.Rect(0, 0, b.Dx()*int(escala), b.Dy()*int(escala)))
	for y := 0; y < out.Rect.Dy(); y++ {
		for x := 0; x < out.Rect.Dx(); x++ {
			out.Set(x, y, src.At(b.Min.X+x/int(escala), b.Min.Y+y/int(escala)))
		}
	}
	f, err := os.Create(ruta)
	if err != nil {
		return err
	}
	if err = png.Encode(f, out); err != nil {
		f.Close()
		return err
	}
	return f.Close()
}

type _hgCRTGame struct {
	ebiten.Game
	shader *ebiten.Shader
}

func (g *_hgCRTGame) DrawFinalScreen(screen ebiten.FinalScreen, offscreen *ebiten.Image, geoM ebiten.GeoM) {
	op := &ebiten.DrawRectShaderOptions{}
	op.Images[0] = offscreen
	op.GeoM = geoM
	op.Uniforms = map[string]any{"Scale": float32(math.Abs(geoM.Element(0, 0)))}
	size := offscreen.Bounds().Size()
	screen.DrawRectShader(size.X, size.Y, g.shader, op)
}

const _hgCRTSource = `//kage:unit pixels
package main

var Scale float

func Fragment(dst vec4, src vec2, color vec4) vec4 {
 origin := imageSrc0Origin()
 size := imageSrc0Size()
 local := src - origin
 // Sampling at texel centers preserves the pixelated source at every scale.
 c := imageSrc0At(origin + floor(local) + vec2(0.5))
 detail := clamp((Scale - 1.0) / 2.0, 0.0, 1.0)
 scan := 1.0 - 0.12 * detail * (0.5 + 0.5 * cos(local.y * 6.2831853))
 mask := vec3(1.0)
 column := mod(floor(dst.x), 3.0)
 if column < 1.0 {
  mask = vec3(1.0, 1.0-0.04*detail, 1.0-0.04*detail)
 } else if column < 2.0 {
  mask = vec3(1.0-0.04*detail, 1.0, 1.0-0.04*detail)
 } else {
  mask = vec3(1.0-0.04*detail, 1.0-0.04*detail, 1.0)
 }
 p := local / size * 2.0 - 1.0
 vignette := 1.0 - 0.05 * clamp(dot(p,p), 0.0, 2.0)
 return vec4(c.rgb * mask * scan * vignette, c.a)
}
`

