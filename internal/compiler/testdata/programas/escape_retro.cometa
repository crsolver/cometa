usar std/pincel
usar std/pincel/graficos
usar std/pincel/color
usar std/pincel/entrada
usar std/pincel/retro

// La última luz. Flechas: mover/atacar; Espacio: esperar.
// Enter: avanzar diálogo; R: reiniciar toda la aventura.
// Paleta de 24 colores, en el orden original. Todo es opaco.
var paleta = crear_paleta()

fn crear_paleta() [color.Color]
	var colores [color.Color] = []
	colores.agregar(color.rgba(0, 0, 0))
	colores.agregar(color.rgba(0, 43, 36))
	colores.agregar(color.rgba(24, 30, 42))
	colores.agregar(color.rgba(84, 106, 0))
	colores.agregar(color.rgba(25, 17, 74))
	colores.agregar(color.rgba(47, 42, 76))
	colores.agregar(color.rgba(68, 63, 65))
	colores.agregar(color.rgba(8, 66, 72))
	colores.agregar(color.rgba(40, 84, 72))
	colores.agregar(color.rgba(82, 82, 76))
	colores.agregar(color.rgba(115, 97, 80))
	colores.agregar(color.rgba(119, 120, 91))
	colores.agregar(color.rgba(94, 82, 107))
	colores.agregar(color.rgba(130, 91, 49))
	colores.agregar(color.rgba(181, 59, 89))
	colores.agregar(color.rgba(255, 87, 119))
	colores.agregar(color.rgba(255, 185, 21))
	colores.agregar(color.rgba(255, 224, 119))
	colores.agregar(color.rgba(67, 62, 166))
	colores.agregar(color.rgba(71, 114, 191))
	colores.agregar(color.rgba(150, 102, 238))
	colores.agregar(color.rgba(87, 176, 103))
	colores.agregar(color.rgba(153, 215, 229))
	colores.agregar(color.rgba(255, 249, 228))
	colores

fn tinta(indice entero) color.Color
	paleta.obtener(indice) o color.rgba(0, 0, 0)

fn absoluto(valor entero) entero
	si valor < 0 retornar -valor
	valor

fn paso(valor entero) entero
	si valor < 0 retornar -1
	si valor > 0 retornar 1
	0

tipo Entidad
	x entero
	y entero
	clase cadena
	activa bool

tipo Dialogo
	voz cadena
	texto cadena

tipo Partida
	nivel entero
	vida entero
	x entero
	y entero
	llave bool
	finalizada bool
	victoria bool
	mapa [cadena]
	enemigos [Entidad]
	objetos [Entidad]
	dialogos [Dialogo]
	pagina entero
	titulo cadena
	mensaje cadena

	fn reiniciar()
		@vida = 5
		@finalizada = falso
		@victoria = falso
		@cargar(1)

	// # muro, @ inicio, K llave, H corazón, X esqueleto, E salida.
	// Los marcadores son suelo; su estado vive en entidades separadas.
	fn cargar(nivel entero)
		@nivel = nivel
		@llave = falso
		@enemigos = []
		@objetos = []
		@dialogos = []
		@pagina = 0
		@mensaje = "Busca la llave. La luz te espera."
		si nivel == 1
			@titulo = "I / EL DESPERTAR"
			@mapa = []
			@mapa.agregar("##################")
			@mapa.agregar("#@....#.........E#")
			@mapa.agregar("#.....#..........#")
			@mapa.agregar("#.....#....X.....#")
			@mapa.agregar("#................#")
			@mapa.agregar("#..X......####...#")
			@mapa.agregar("#.....#..........#")
			@mapa.agregar("#..K..#.....H....#")
			@mapa.agregar("#.....#..........#")
			@mapa.agregar("##################")
			@decir("Lía / Guardiana", "¿Me oyes, viajero? Soy Lía.\nLa torre se apagó y sus guardianes\nolvidaron nuestros nombres.")
			@decir("Lía / Guardiana", "Trae la última luz a la cima.\nBusca una llave en cada piso.\nAcércate a los huesos para atacar.")
		osi nivel == 2
			@titulo = "II / El jardín dormido"
			@mapa = []
			@mapa.agregar("##################")
			@mapa.agregar("#@...............#")
			@mapa.agregar("#..###....###....#")
			@mapa.agregar("#....X...........#")
			@mapa.agregar("#......##.....K..#")
			@mapa.agregar("#..H...##........#")
			@mapa.agregar("#.........X......#")
			@mapa.agregar("#..###....###....#")
			@mapa.agregar("#E............X..#")
			@mapa.agregar("##################")
			@decir("VIAJERO", "Hay raíces entre las piedras...\n¿Antes crecía algo aquí?")
			@decir("Lía / Guardiana", "Un jardín. Mi hermana lo cuidaba.\nCon luz, quizá las semillas\nrecuerden cómo despertar.")
		sino
			@titulo = "III / EL FARO SIN SOL"
			@mapa = []
			@mapa.agregar("##################")
			@mapa.agregar("#@......#.......E#")
			@mapa.agregar("#...X...#........#")
			@mapa.agregar("#.......#...X....#")
			@mapa.agregar("#..##.......##...#")
			@mapa.agregar("#.......H........#")
			@mapa.agregar("#..X....#........#")
			@mapa.agregar("#.......#....X...#")
			@mapa.agregar("#..K....#........#")
			@mapa.agregar("##################")
			@decir("Lía / Guardiana", "El faro está detrás de esa puerta.\nYo no pude llegar. Tuve miedo.")
			@decir("VIAJERO", "Entonces subiremos por los dos.\nAún queda una chispa.")
		repetir (@mapa) |fila, y|
			repetir (0..fila.longitud()) |x|
				var celda = fila.obtener(x) o "#"
				si celda == "@"
					@x = x
					@y = y
				si celda == "X"
					@enemigos.agregar(Entidad {x: x, y: y, clase: celda, activa: verdadero})
				si celda == "K" || celda == "H"
					@objetos.agregar(Entidad {x: x, y: y, clase: celda, activa: verdadero})

	fn decir(voz cadena, texto cadena)
		@dialogos.agregar(Dialogo {voz: voz, texto: texto})

	fn celda(x entero, y entero) cadena
		var fila = @mapa.obtener(y) o ""
		fila.obtener(x) o "#"

	fn ocupado(x entero, y entero) bool
		repetir (@enemigos) |enemigo|
			si enemigo.activa && enemigo.x == x && enemigo.y == y retornar verdadero
		falso

	fn libre(x entero, y entero) bool
		@celda(x, y) != "#" && @celda(x, y) != "E" && @ocupado(x, y) == falso && (x != @x || y != @y)

	fn recoger()
		repetir (@objetos) |objeto|
			si objeto.activa && objeto.x == @x && objeto.y == @y
				si objeto.clase == "K"
					objeto.activa = falso
					@llave = verdadero
					@mensaje = "La puerta está abierta."
					si @nivel == 1
						@decir("Lía / Guardiana", "Esa llave tiene el sello del alba.\nTe reconoce. Sigue subiendo.")
					osi @nivel == 2
						@decir("VIAJERO", "Una semilla junto a la llave...\nLa llevaré donde alcance el sol.")
					sino
						@decir("Lía / Guardiana", "La última cerradura.\nAl otro lado espera el amanecer.")
				osi @vida < 5
					objeto.activa = falso
					@vida = @vida + 1
					@mensaje = "Una brasa te devuelve un corazón."

	// Un turno por acción válida. Golpear no mueve al jugador.
	fn actuar(dx entero, dy entero)
		var x = @x + dx
		var y = @y + dy
		si @celda(x, y) == "#" retornar
		si @celda(x, y) == "E" && @llave == falso
			@mensaje = "La puerta necesita una llave."
			retornar
		@mensaje = "Los pasos resuenan en la torre."
		var golpe = falso
		repetir (@enemigos) |enemigo|
			si enemigo.activa && enemigo.x == x && enemigo.y == y
				enemigo.activa = falso
				golpe = verdadero
				@mensaje = "El guardián vuelve a descansar."
		si golpe == falso
			@x = x
			@y = y
			@recoger()
			si @celda(x, y) == "E"
				si @nivel < 3
					@cargar(@nivel + 1)
				sino
					@finalizada = verdadero
					@victoria = verdadero
					@mensaje = "La torre vuelve a brillar."
					@decir("VIAJERO", "La chispa prende. Veo el valle...\n¡Lía, las ventanas se iluminan!")
					@decir("Lía / Guardiana", "Y el jardín volverá a florecer.\nGracias por traer la mañana.")
					@decir("La última luz", "La semilla quedó junto al faro.\nAl alba, nació la primera hoja.\nFIN / Gracias por jugar.")
				retornar
		@turno_enemigos()

	fn turno_enemigos()
		repetir (@enemigos) |enemigo|
			si enemigo.activa == falso continuar
			var dx = @x - enemigo.x
			var dy = @y - enemigo.y
			si absoluto(dx) + absoluto(dy) == 1
				@vida = @vida - 1
				@mensaje = "Un golpe apaga parte de tu luz."
				si @vida == 0
					@finalizada = verdadero
					@dialogos = []
					@pagina = 0
					@decir("Lía / Guardiana", "No dejes que este sea el final.\nCierra los ojos. Busca la chispa.\nPodemos intentarlo otra vez.")
					retornar
				continuar
			// Eje mayor primero; en empate, horizontal. Prueba el otro si falla.
			var mx = paso(dx)
			var my = 0
			si absoluto(dy) > absoluto(dx)
				mx = 0
				my = paso(dy)
			si @libre(enemigo.x + mx, enemigo.y + my) == falso
				si mx != 0
					mx = 0
					my = paso(dy)
				sino
					mx = paso(dx)
					my = 0
			si @libre(enemigo.x + mx, enemigo.y + my)
				enemigo.x = enemigo.x + mx
				enemigo.y = enemigo.y + my

	pub fn actualizar(dt decimal)
		si entrada.tecla_presionada(.R)
			@reiniciar()
			retornar
		si @pagina < @dialogos.longitud()
			si entrada.tecla_presionada(.Enter) @pagina = @pagina + 1
			retornar
		si @finalizada retornar
		si entrada.tecla_presionada(.Arriba) @actuar(0, -1)
		osi entrada.tecla_presionada(.Abajo) @actuar(0, 1)
		osi entrada.tecla_presionada(.Izquierda) @actuar(-1, 0)
		osi entrada.tecla_presionada(.Derecha) @actuar(1, 0)
		osi entrada.tecla_presionada(.Espacio) @actuar(0, 0)

	pub fn pintar()
		graficos.limpiar(tinta(0))
		retro.texto("La última luz", 16, 8, color = tinta(17))
		repetir (0..5) |i|
			si i < @vida
				retro.icono(.Corazon, 224 + i * 16, 8, color = tinta(15))
			sino
				retro.icono(.CorazonVacio, 224 + i * 16, 8, color = tinta(12))
		retro.texto(@titulo, 16, 24, color = tinta(22))
		si @llave retro.icono(.Llave, 296, 24, color = tinta(16))
		var muro = 12
		var suelo = 2
		si @nivel == 2
			muro = 8
			suelo = 1
		si @nivel == 3
			muro = 18
			suelo = 4
		repetir (@mapa) |fila, y|
			repetir (0..fila.longitud()) |x|
				var px = 16 + x * 16
				var py = 40 + y * 16
				graficos.rectangulo(px, py, 16, 16, tinta(suelo))
				var celda = @celda(x, y)
				si celda == "#"
					graficos.rectangulo(px, py, 16, 15, tinta(muro))
					graficos.rectangulo(px + 1, py + 1, 14, 6, tinta(suelo))
					graficos.rectangulo(px + 7, py + 8, 1, 7, tinta(suelo))
				osi celda == "E"
					var tinte = 13
					si @llave tinte = 17
					retro.texto(">", px, py, escala = 2, color = tinta(tinte))
				sino
					retro.texto(".", px + 4, py + 4, color = tinta(muro))
		repetir (@objetos) |objeto|
			si objeto.activa
				si objeto.clase == "K"
					retro.icono(.Llave, 16 + objeto.x * 16, 40 + objeto.y * 16, escala = 2, color = tinta(16))
				sino
					retro.icono(.Corazon, 16 + objeto.x * 16, 40 + objeto.y * 16, escala = 2, color = tinta(21))
		repetir (@enemigos) |enemigo|
			si enemigo.activa
				retro.icono(.Calavera, 16 + enemigo.x * 16, 40 + enemigo.y * 16, escala = 2, color = tinta(23))
		retro.texto("@", 16 + @x * 16, 40 + @y * 16, escala = 2, color = tinta(22))
		retro.texto(@mensaje, 16, 204, color = tinta(17))
		retro.texto("Flechas: mover / atacar", 16, 220, color = tinta(11))
		retro.texto("Espacio: esperar   R: reiniciar", 16, 232, color = tinta(11))
		si @finalizada
			graficos.rectangulo(24, 80, 272, 48, tinta(2))
			si @victoria
				retro.texto("AMANECER", 96, 88, escala = 2, color = tinta(17))
			sino
				retro.texto("SIN LUZ", 104, 88, escala = 2, color = tinta(15))
			retro.texto("R / Volver al principio", 72, 112, color = tinta(23))
		si @pagina < @dialogos.longitud()
			var dialogo = @dialogos.obtener(@pagina) o Dialogo {}
			graficos.rectangulo(8, 104, 304, 124, tinta(0))
			graficos.rectangulo(10, 106, 300, 120, tinta(17))
			graficos.rectangulo(12, 108, 296, 116, tinta(2))
			retro.icono(.Espada, 24, 116, color = tinta(16))
			retro.texto(dialogo.voz, 40, 116, color = tinta(22))
			retro.texto(dialogo.texto, 24, 140, color = tinta(23))
			retro.texto("ENTER / Continuar", 24, 200, color = tinta(17))
			retro.texto("R / Reiniciar", 24, 212, color = tinta(11))

fn inicio()
	var partida = Partida {}
	partida.reiniciar()
	pincel.ejecutar(partida, 320, 240, titulo = "La última luz / Cometa retro", escala = 3, pixelado = verdadero, retro = verdadero) atrapar |error|
		imprimir(error)
