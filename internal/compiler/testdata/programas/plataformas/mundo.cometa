usar std/mate
usar std/mate/ruido

// Simulación independiente de Pincel: posiciones en píxeles del mundo.
const columnas entero = 240
const filas entero = 68
const bloque entero = 8

tipo Cuerpo
	pub pos mate.Vec2
	pub vel mate.Vec2
	ancho decimal
	alto decimal
	pub suelo bool

tipo Enemigo
	pub cuerpo Cuerpo
	pub clase entero
	pub vida entero
	pub reloj decimal
	pub golpe decimal

tipo Bala
	pub pos mate.Vec2
	pub dir mate.Vec2
	pub vida decimal

tipo Particula
	pub pos mate.Vec2
	pub vel mate.Vec2
	pub vida decimal
	pub clase entero

tipo Control
	pub eje decimal
	pub salto bool
	pub sostener bool
	pub disparo bool
	pub minar bool
	pub raton mate.Vec2

fn acercar(valor decimal, destino decimal, paso decimal) decimal
	si valor < destino mate.minimo(valor + paso, destino) sino mate.maximo(valor - paso, destino)

pub tipo Mundo
	pub celdas [entero]
	pub alturas [entero]
	pub enemigos [Enemigo]
	pub balas [Bala]
	pub particulas [Particula]
	pub jugador Cuerpo
	pub semilla entero
	pub vida entero
	pub mineral entero
	pub reloj decimal
	pub invulnerable decimal
	coyote decimal
	buffer decimal
	recarga decimal
	pub fogonazo decimal
	pub cam_x entero
	pub cam_y entero
	pub mira mate.Vec2
	pub objetivo entero
	pub progreso decimal
	bajas entero

	pub fn celda(x entero, y entero) entero
		si x < 0 || x >= columnas || y < 0 || y >= filas retornar 5
		@celdas[y * columnas + x]

	fn poner(x entero, y entero, material entero)
		si x > 0 && x < columnas - 1 && y > 0 && y < filas - 1
			@celdas[y * columnas + x] = material

	fn protegido(x entero, y entero) bool
		x <= 0 || x >= columnas - 1 || y <= 0 || y >= filas - 1 || (x >= 4 && x <= 12 && y == 14)

	fn choca(pos mate.Vec2, ancho decimal, alto decimal) bool
		repetir (mate.piso(pos.y / 8)..(mate.piso((pos.y + alto - 0.001) / 8) + 1)) |y|
			repetir (mate.piso(pos.x / 8)..(mate.piso((pos.x + ancho - 0.001) / 8) + 1)) |x|
				si @celda(x, y) != 0 retornar verdadero
		falso

	// Pasos de un píxel: no atraviesa paredes ni con velocidad de caída máxima.
	fn mover(cuerpo Cuerpo, dt decimal)
		var pasos = mate.techo(mate.maximo(mate.absoluto(cuerpo.vel.x * dt), mate.absoluto(cuerpo.vel.y * dt))) + 1
		cuerpo.suelo = falso
		repetir (0..pasos) |paso|
			var dx = cuerpo.vel.x * dt / pasos
			var dy = cuerpo.vel.y * dt / pasos
			var px = cuerpo.pos + mate.Vec2 {dx, 0}
			si @choca(px, cuerpo.ancho, cuerpo.alto)
				cuerpo.vel.x = 0
			sino
				cuerpo.pos = px
			var py = cuerpo.pos + mate.Vec2 {0, dy}
			si @choca(py, cuerpo.ancho, cuerpo.alto)
				si dy > 0 cuerpo.suelo = verdadero
				cuerpo.vel.y = 0
			sino
				cuerpo.pos = py

	fn camara()
		@cam_x = mate.piso(mate.limitar((@jugador.pos.x + 3) / 320, 0, 5)) * 320
		@cam_y = mate.piso(mate.limitar((@jugador.pos.y + 5.5) / 180, 0, 2)) * 180

	pub fn centro() mate.Vec2
		@jugador.pos + mate.Vec2 {3, 5}

	pub fn reaparecer()
		@jugador = Cuerpo {pos: {61, 100}, ancho: 6, alto: 11}
		@vida = 5
		@invulnerable = 2
		@coyote = 0
		@buffer = 0
		@objetivo = -1
		@progreso = 0
		@balas = []
		@camara()

	pub fn generar(semilla entero)
		@semilla = semilla
		@celdas = []
		@alturas = []
		@enemigos = []
		@particulas = []
		@mineral = 0
		@bajas = 0
		@reloj = 0
		repetir (0..columnas) |x|
			var h = 12 + mate.piso(ruido.fractal(x * 0.045, 0.37, semilla) * 7)
			si x >= 3 && x <= 13 h = 14
			@alturas.agregar(h)
		repetir (0..filas) |y|
			repetir (0..columnas) |x|
				var material = 0
				var h = @alturas[x]
				si y >= h
					material = si y == h 1 sino si y < h + 5 2 sino si y < 47 3 sino 5
					si y > h + 5 && ruido.fractal(x * 0.09, y * 0.13, semilla + 7) < 0.40 material = 0
					si material != 0 && y > h + 3 && ruido.suave(x * 0.41, y * 0.37, semilla + 17) > 0.74 material = 4
				@celdas.agregar(material)
		// Dos galerías continuas, con suelo ondulado de pendiente suave.
		repetir (2..(columnas - 2)) |x|
			repetir (0..2) |nivel|
				var piso = 33 + nivel * 21 + mate.piso(mate.seno(x * 0.045) * 2)
				repetir ((piso - 4)..piso) |y| @poner(x, y, 0)
				@poner(x, piso, 3 + nivel * 2)
		// Rampas diagonales unen superficie y galerías; se pueden subir saltando.
		repetir (0..6) |seccion|
			repetir (12..57) |y|
				var t = (y - 12) % 40
				var x = seccion * 40 + 15 + si t < 20 t sino 40 - t
				repetir ((x - 2)..(x + 3)) |col| @poner(col, y, 0)
		// Refugio: limpiar el inicio y conservar su plataforma tras la minería.
		repetir (4..13) |x|
			repetir (8..14) |y| @poner(x, y, 0)
			@poner(x, 14, 1)
		repetir (0..columnas) |x|
			@celdas[x] = 5
			@celdas[(filas - 1) * columnas + x] = 5
		repetir (0..filas) |y|
			@celdas[y * columnas] = 5
			@celdas[y * columnas + columnas - 1] = 5
		// Enemigos únicamente en espacios válidos, lejos del refugio.
		repetir (18..(columnas - 3)) |x|
			si x % 13 == 0
				repetir (8..(filas - 3)) |y|
					si @celda(x, y) == 0 && @celda(x, y - 1) == 0 && @celda(x, y + 1) != 0
						var clase = si y > 22 && x % 2 == 0 1 sino 0
						@enemigos.agregar(Enemigo {cuerpo: {pos: {x * 8, y * 8}, ancho: 8, alto: 7}, clase: clase, reloj: x * 0.07, vida: 3})
						romper
			// Murciélagos en la galería profunda.
				si x % 26 == 0
					var y = 51 + mate.piso(mate.seno(x * 0.045) * 2)
					@enemigos.agregar(Enemigo {cuerpo: {pos: {x * 8, y * 8}, ancho: 8, alto: 7}, clase: 1, vida: 3})
		@reaparecer()

	fn emitir(pos mate.Vec2, clase entero, cantidad entero)
		repetir (0..cantidad) |i|
			si @particulas.longitud() >= 180 retornar
			var angulo = i * 2.4 + @reloj * 13
			@particulas.agregar(Particula {pos: pos, vel: {mate.coseno(angulo) * (18 + (i % 10) * 3), -18 - mate.absoluto(mate.seno(angulo)) * 40}, vida: 0.25 + (i % 10) * 0.025, clase: clase})

	fn caminar(control Control, dt decimal)
		@buffer = mate.maximo(0, @buffer - dt)
		@coyote = mate.maximo(0, @coyote - dt)
		si @jugador.suelo @coyote = 0.1
		si control.salto @buffer = 0.12
		var aceleracion = si @jugador.suelo 950.0 sino 650.0
		si control.eje == 0 aceleracion = si @jugador.suelo 1300.0 sino 400.0
		@jugador.vel.x = acercar(@jugador.vel.x, control.eje * 88, aceleracion * dt)
		si @buffer > 0 && @coyote > 0
			@jugador.vel.y = -225
			@buffer = 0
			@coyote = 0
			@jugador.suelo = falso
			@emitir(@jugador.pos + mate.Vec2 {3, 11}, 0, 5)
		si control.sostener == falso && @jugador.vel.y < -85 @jugador.vel.y = -85
		@jugador.vel.y = mate.minimo(260, @jugador.vel.y + 700 * dt)
		var estaba_suelo = @jugador.suelo
		@mover(@jugador, dt)
		si @jugador.suelo && estaba_suelo == falso @emitir(@jugador.pos + mate.Vec2 {3, 11}, 0, 4)
		@camara()

	// Primer sólido del rayo. Sirve tanto para alcance como para oclusión.
	fn apuntar(destino mate.Vec2) entero
		var origen = @centro()
		var delta = destino - origen
		var distancia = delta.longitud()
		si distancia < 1 || distancia > 48 retornar -1
		var direccion = delta.normalizado()
		repetir (0..(mate.techo(distancia) + 1)) |paso|
			var punto = origen + direccion * paso
			var x = mate.piso(punto.x / 8)
			var y = mate.piso(punto.y / 8)
			si @celda(x, y) != 0
				si @protegido(x, y) retornar -1
				retornar y * columnas + x
		-1

	pub fn dureza(material entero) decimal
		si material == 1 || material == 2 0.18 sino si material == 3 0.38 sino si material == 4 0.55 sino 0.7

	fn herramientas(control Control, dt decimal)
		@mira = control.raton + mate.Vec2 {@cam_x, @cam_y}
		@recarga = mate.maximo(0, @recarga - dt)
		@fogonazo = mate.maximo(0, @fogonazo - dt)
		var direccion = (@mira - @centro()).normalizado()
		si direccion.longitud() == 0 direccion = {1, 0}
		si control.disparo && @recarga <= 0 && @balas.longitud() < 32
			@balas.agregar(Bala {pos: @centro(), dir: direccion, vida: 1.2})
			@recarga = 0.14
			@fogonazo = 0.055
		var indice = @apuntar(@mira)
		si indice != @objetivo || control.minar == falso @progreso = 0
		@objetivo = indice
		si control.minar && indice >= 0
			@progreso = @progreso + dt
			var material = @celdas[indice]
			si @progreso >= @dureza(material)
				@celdas[indice] = 0
				@progreso = 0
				@objetivo = -1
				si material == 4 @mineral = @mineral + 1
				@emitir({(indice % columnas) * 8 + 4, (indice / columnas) * 8 + 4}, si material == 4 2 sino 0, 9)

	fn combatir(dt decimal)
		var i = 0
		repetir
			si i >= @balas.longitud() romper
			var bala = @balas[i]
			bala.vida = bala.vida - dt
			var pasos = mate.techo(330 * dt)
			repetir (0..pasos) |paso|
				bala.pos = bala.pos + bala.dir * (330 * dt / pasos)
				si @celda(mate.piso(bala.pos.x / 8), mate.piso(bala.pos.y / 8)) != 0
					bala.vida = 0
					@emitir(bala.pos, 2, 3)
					romper
				repetir (@enemigos) |enemigo|
					si enemigo.vida > 0 && (mate.Rect {enemigo.cuerpo.pos, {8, 7}}).contiene(bala.pos)
						enemigo.vida = enemigo.vida - 1
						enemigo.golpe = 0.12
						bala.vida = 0
						@emitir(bala.pos, 1, 5)
						si enemigo.vida == 0
							@bajas = @bajas + 1
							@emitir(bala.pos, 1, 8)
						romper
				si bala.vida <= 0 romper
			si bala.vida <= 0 @balas.eliminar(i)
			sino i = i + 1

	fn criaturas(dt decimal)
		repetir (@enemigos) |enemigo|
			si enemigo.vida <= 0 continuar
			var cuerpo = enemigo.cuerpo
			si mate.absoluto(cuerpo.pos.x - @cam_x - 160) > 480 || mate.absoluto(cuerpo.pos.y - @cam_y - 90) > 270 continuar
			enemigo.reloj = enemigo.reloj + dt
			enemigo.golpe = mate.maximo(0, enemigo.golpe - dt)
			var delta = @centro() - (cuerpo.pos + mate.Vec2 {4, 3})
			var cerca = delta.longitud() < 145
			si enemigo.clase == 0
				cuerpo.vel.y = mate.minimo(230, cuerpo.vel.y + 700 * dt)
				si cuerpo.suelo
					cuerpo.vel.x = acercar(cuerpo.vel.x, 0, 250 * dt)
					si enemigo.reloj > 1.05
						enemigo.reloj = 0
						cuerpo.vel.y = -155
						cuerpo.vel.x = mate.seno(@reloj + cuerpo.pos.x) * 32
						si cerca
							cuerpo.vel.x = 38
							si delta.x < 0 cuerpo.vel.x = -38
			sino
				var direccion = delta.normalizado()
				cuerpo.vel.x = si cerca direccion.x * 27 sino mate.seno(enemigo.reloj * 1.5) * 18
				cuerpo.vel.y = si cerca direccion.y * 27 sino mate.coseno(enemigo.reloj * 2) * 14
			@mover(cuerpo, dt)
			// El refugio también repele a los enemigos.
			si cuerpo.pos.x < 110 && cuerpo.pos.y < 120
				cuerpo.pos.x = 110
				cuerpo.vel.x = 30
			si @invulnerable <= 0 && (mate.Rect {@jugador.pos, {6, 11}}).interseca({cuerpo.pos, {8, 7}})
				@vida = @vida - 1
				@invulnerable = 1.2
				@jugador.vel = {120, -110}
				si delta.x < 0 @jugador.vel.x = -120
				@emitir(@centro(), 1, 10)
				si @vida <= 0 @reaparecer()

	pub fn actualizar(control Control, dt decimal)
		@reloj = @reloj + dt
		@invulnerable = mate.maximo(0, @invulnerable - dt)
		@caminar(control, dt)
		@herramientas(control, dt)
		@combatir(dt)
		@criaturas(dt)
		var i = 0
		repetir
			si i >= @particulas.longitud() romper
			var p = @particulas[i]
			p.vida = p.vida - dt
			p.vel.y = p.vel.y + 160 * dt
			p.pos = p.pos + p.vel * dt
			si p.vida <= 0 @particulas.eliminar(i)
			sino i = i + 1
