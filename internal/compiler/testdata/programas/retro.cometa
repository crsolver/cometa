usar std/pincel
usar std/pincel/graficos
usar std/pincel/retro

tipo Galeria
	pub fn actualizar(dt decimal) retornar
	pub fn pintar()
		graficos.limpiar(.Azul)
		retro.texto("DUNGEON       ASCII", 8, 8)
		repetir (0..256) |indice|
			var x = (indice % 16) * 8
			var y = (indice / 16) * 8
			retro.glifo(indice, 8 + x, 24 + y)
			retro.glifo(indice, 152 + x, 24 + y, atlas = .ASCII)
		retro.texto("fila * 16 + columna = indice", 8, 160)
		retro.texto("¡Sí! ¿Niño? áéíóú ü ñ Ñ", 8, 176)
		retro.icono(.Corazon, 8, 192, color = .Rojo)
		retro.icono(.CorazonVacio, 24, 192)
		retro.icono(.Espada, 40, 192)
		retro.icono(.Escudo, 56, 192)
		retro.icono(.Llave, 72, 192, color = .Amarillo)
		retro.icono(.Calavera, 88, 192)
		retro.icono(.Arriba, 104, 192)
		retro.icono(.Abajo, 120, 192)
		retro.icono(.Izquierda, 136, 192)
		retro.icono(.Derecha, 152, 192)

fn inicio()
	pincel.ejecutar(Galeria {}, 288, 208, titulo = "Pincel retro", escala = 4, retro = verdadero) capturar |error|
		imprimir(error)
