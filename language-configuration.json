{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\t*(?:(?:(?:tipo|enum)\\s+[A-Za-z_][A-Za-z0-9_]*|fn\\s+[A-Za-z_][A-Za-z0-9_]*\\([^)]*\\)(?:\\s+(?:num|cadena|bool|\\[[^]]+\\]|[A-Za-z_][A-Za-z0-9_]*))?|(?:si|osi)\\s+(?:\\([^)]*\\)|[^\\s]+)|sino|repetir(?:\\s+\\([^)]*\\)\\s+\\|[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)?\\|)?)\\s*(?://.*)?|(?:.*\\bcasos\\s+.+|[A-Za-z_][A-Za-z0-9_]*\\s*=>|.*\\{)\\s*(?://.*)?)$",
    "decreaseIndentPattern": "^\\t*(?:(?:osi|sino)\\b|\\})"
  }
}
