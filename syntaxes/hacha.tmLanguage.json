{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hacha",
  "scopeName": "source.hacha",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#enum-patterns" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#receiver-members" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "enum-patterns": {
      "patterns": [{
        "match": "^(\\t+)(?:([A-Za-z_][A-Za-z0-9_]*))?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=>)",
        "captures": {
          "2": { "name": "entity.name.type.hacha" },
          "3": { "name": "punctuation.accessor.hacha" },
          "4": { "name": "constant.other.enum.hacha" }
        }
      }]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hacha",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.hacha" } },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hacha",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hacha" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.hacha" } },
          "patterns": [
            { "name": "constant.character.escape.hacha", "match": "\\\\(?:[\\\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.hacha" },
            "3": { "name": "entity.name.function.hacha" }
          }
        },
        {
          "match": "\\b(tipo|enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.hacha" },
            "3": { "name": "entity.name.type.hacha" }
          }
        },
        {
          "match": "\\b(var)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.hacha" },
            "3": { "name": "variable.other.readwrite.hacha" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.hacha", "match": "\\b(?:si|osi|sino|casos|o|capturar|intentar|retornar)\\b" },
        { "name": "keyword.control.loop.hacha", "match": "\\b(?:repetir|continuar|romper)\\b" },
        { "name": "storage.type.function.hacha", "match": "\\bfn\\b" },
        { "name": "storage.type.struct.hacha", "match": "\\b(?:tipo|enum)\\b" },
        { "name": "storage.type.variable.hacha", "match": "\\bvar\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.hacha", "match": "\\b(?:num|bool|cadena)\\b" },
        { "name": "support.type.hacha", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.hacha", "match": "\\b(?:verdadero|falso)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hacha", "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]+)?)(?![A-Za-z0-9_])" }
      ]
    },
    "receiver-members": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.hacha" },
            "2": { "name": "variable.other.member.hacha" }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.hacha" },
            "2": { "name": "variable.other.member.hacha" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        { "name": "support.function.builtin.hacha", "match": "\\bimprimir(?=\\s*\\()" },
        { "name": "entity.name.function.call.hacha", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.variadic.hacha", "match": "\\.\\.\\." },
        { "name": "keyword.operator.range.hacha", "match": "\\.\\." },
        { "name": "keyword.operator.hacha", "match": "=>|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=<>!?]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.hacha", "match": "," },
        { "name": "punctuation.separator.key-value.hacha", "match": ":" },
        { "name": "punctuation.accessor.hacha", "match": "\\." },
        { "name": "punctuation.section.group.hacha", "match": "[()\\[\\]{}]" },
        { "name": "punctuation.definition.parameters.hacha", "match": "\\|" }
      ]
    }
  }
}
