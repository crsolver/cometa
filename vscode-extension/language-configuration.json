{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\t*(?:(?:(?:tipo|enum)\\s+[A-Za-z_][A-Za-z0-9_]*|fn\\s+[A-Za-z_][A-Za-z0-9_]*\\([^)]*\\)(?:\\s+(?:entero|decimal|cadena|bool|\\[[^]]+\\]|[A-Za-z_][A-Za-z0-9_]*))?|(?:si|osi)\\s+(?:\\([^)]*\\)|[^\\s]+)|sino|repetir(?:\\s+\\([^)]*\\)\\s+\\|[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)?\\|)?)\\s*(?://.*)?|(?:.*\\bcasos\\s+.+|[A-Za-z_][A-Za-z0-9_]*\\s*=>|.*\\{)\\s*(?://.*)?)$|^\\t*fn\\s+[A-Za-z_][A-Za-z0-9_]*\\([^\\r\\n]*\\)\\s+[A-Za-z0-9_\\[\\]()?!]+\\s*(?://.*)?$|^\\t*(?:si|osi)\\s+.+\\|[A-Za-z_][A-Za-z0-9_]*\\|\\s*(?://.*)?$|^.*\\b(?:o|atrapar)(?:\\s+\\|[A-Za-z_][A-Za-z0-9_]*\\|)?\\s*(?://.*)?$|^\\t*(?:tipo|enum|interfaz)\\s+[A-Za-z_][A-Za-z0-9_]*(?:<[^\\r\\n]+>)?\\s*(?://.*)?$|^\\t*fn\\s+[A-Za-z_][A-Za-z0-9_]*<[^\\r\\n]+>\\([^\\r\\n]*\\)(?:\\s+[A-Za-z0-9_<> ,\\[\\]()?!]+)?\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\t*(?:(?:osi|sino)\\b|\\})"
  }
}
