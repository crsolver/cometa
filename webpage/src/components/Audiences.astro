---
const aprender = [
	'Palabras clave en español que se leen como instrucciones.',
	'Mensajes de error claros que señalan la línea exacta.',
	'Bloques con tabulaciones: sin llaves ni puntos y comas.',
	'Haz un juego en tu primera tarde y ve tu código moverse.',
];
const expertos = [
	'Genéricos con restricciones: fn describir<T Describible>.',
	'Interfaces estructurales, enums con datos y casos exhaustivo.',
	'Módulos con usar, visibilidad pub y biblioteca estándar.',
	'Compila a Go: ejecutables nativos y rápidos.',
];
---

<section class="seccion">
	<div class="contenedor">
		<div class="encabezado centrado">
			<span class="etiqueta">// para todos</span>
			<h2>Un lenguaje, <span class="resaltado">dos superpoderes.</span></h2>
		</div>

		<div class="columnas">
			<article class="tarjeta columna aprender">
				<span class="chip">🎒 Para aprender</span>
				<h3>Tu primer lenguaje, sin barreras de idioma.</h3>
				<ul>{aprender.map((t) => <li>{t}</li>)}</ul>
			</article>
			<article class="tarjeta columna expertos">
				<span class="chip">🚀 Para expertos</span>
				<h3>Las ideas de los lenguajes modernos, en serio.</h3>
				<ul>{expertos.map((t) => <li>{t}</li>)}</ul>
			</article>
		</div>
	</div>
</section>

<style>
	.centrado {
		margin-inline: auto;
		text-align: center;
	}
	.columnas {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: 1.2rem;
	}
	.columna {
		padding: clamp(1.6rem, 4vw, 2.4rem);
		position: relative;
		overflow: hidden;
	}
	.columna::before {
		content: '';
		position: absolute;
		inset: -40% -40% auto auto;
		width: 60%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--acento);
		opacity: 0.12;
		filter: blur(50px);
		pointer-events: none;
	}
	.aprender {
		--acento: var(--turquesa);
		--acento-texto: var(--turquesa);
	}
	.expertos {
		--acento: var(--indigo-vivo);
		--acento-texto: var(--pervinca);
	}
	.chip {
		display: inline-block;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.9rem;
		margin-bottom: 1rem;
		color: var(--acento-texto);
		background: color-mix(in srgb, var(--acento) 16%, transparent);
	}
	h3 {
		font-size: clamp(1.4rem, 2.5vw, 1.8rem);
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.8rem;
	}
	li {
		display: flex;
		gap: 0.7rem;
		color: var(--tinta-suave);
	}
	li::before {
		content: '✓';
		flex: none;
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--noche);
		background: var(--acento-texto);
		margin-top: 0.1rem;
	}
</style>
