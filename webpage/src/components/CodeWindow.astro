---
import { Code } from 'astro:components';
import { cometa } from '../lib/cometa';
import { temaCometa } from '../lib/tema';

interface Props {
	codigo: string;
	archivo?: string;
	consola?: boolean;
	class?: string;
}
const { codigo, archivo, consola = false, class: clase } = Astro.props;
const limpio = codigo.replace(/\r\n/g, '\n').trimEnd();
---

<figure class:list={['ventana', clase]}>
	<figcaption class="ventana-barra">
		<span class="puntos" aria-hidden="true"><i></i><i></i><i></i></span>
		{archivo && <span class="archivo">{archivo}</span>}
	</figcaption>
	<Code code={limpio} lang={consola ? 'powershell' : cometa} theme={temaCometa} />
</figure>

<style>
	.ventana {
		margin: 0;
		border-radius: var(--radio);
		background: #2d2f50;
		border: 1px solid rgb(255 255 255 / 0.1);
		box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.02) inset;
		overflow: hidden;
		min-width: 0;
	}
	.ventana-barra {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--linea);
		background: rgb(255 255 255 / 0.02);
	}
	.puntos {
		display: flex;
		gap: 0.4rem;
	}
	.puntos i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--lavanda);
	}
	.puntos i:nth-child(2) {
		background: var(--hielo);
	}
	.puntos i:nth-child(3) {
		background: var(--turquesa);
	}
	.archivo {
		font-family: var(--fuente-codigo);
		font-size: 0.8rem;
		color: var(--tinta-suave);
	}
	.ventana :global(pre) {
		margin: 0;
		padding: 1.2rem 1.4rem 1.4rem;
		font-size: 0.9rem;
		line-height: 1.7;
		overflow-x: auto;
		background: transparent !important;
	}
	.ventana :global(pre code) {
		font-size: inherit;
		font-weight: 700;
	}
</style>
