---
import CodeWindow from './CodeWindow.astro';
import basico from '../ejemplos/basico.cometa?raw';
import enums from '../ejemplos/enums.cometa?raw';
import errores from '../ejemplos/errores.cometa?raw';
import genericos from '../ejemplos/genericos.cometa?raw';
import mapas from '../ejemplos/mapas.cometa?raw';

const ejemplos = [
	{
		id: 'basico',
		nombre: 'Lo básico',
		archivo: 'basico.cometa',
		codigo: basico,
		nota: 'Bloques con tabulaciones, interpolación con ${ } y funciones que devuelven su última expresión. Nada sobra.',
	},
	{
		id: 'enums',
		nombre: 'Enums y casos',
		archivo: 'formas.cometa',
		codigo: enums,
		nota: 'Las variantes pueden llevar datos, y casos te obliga a cubrirlas todas: si agregas una forma nueva, el compilador te avisa.',
	},
	{
		id: 'errores',
		nombre: 'Opcionales y errores',
		archivo: 'usuarios.cometa',
		codigo: errores,
		nota: 'Los errores son valores con tipo. Propágalos con intentar, atrápalos con atrapar o da un respaldo con o.',
	},
	{
		id: 'genericos',
		nombre: 'Interfaces y genéricos',
		archivo: 'planetas.cometa',
		codigo: genericos,
		nota: 'Interfaces estructurales y genéricos con restricciones, al estilo de los lenguajes modernos. En español.',
	},
	{
		id: 'mapas',
		nombre: 'Mapas',
		archivo: 'mapas.cometa',
		codigo: mapas,
		nota: 'Diccionarios con [clave: valor]. Leer devuelve un opcional, así que siempre decides qué pasa si falta una clave.',
	},
];
---

<section id="ejemplos" class="seccion">
	<div class="contenedor">
		<div class="encabezado">
			<span class="etiqueta">// ejemplos</span>
			<h2>Código que se lee <span class="resaltado">como un cuento.</span></h2>
			<p>Explora cómo se ve Cometa: desde tu primer programa hasta tipos genéricos.</p>
		</div>

		<div class="pestanas" data-pestanas>
			<div class="lista" role="tablist" aria-label="Ejemplos de código">
				{
					ejemplos.map((e, i) => (
						<button
							type="button"
							role="tab"
							id={`tab-${e.id}`}
							aria-controls={`panel-${e.id}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
						>
							{e.nombre}
						</button>
					))
				}
			</div>

			{
				ejemplos.map((e, i) => (
					<div class="panel" role="tabpanel" id={`panel-${e.id}`} aria-labelledby={`tab-${e.id}`} hidden={i !== 0}>
						<CodeWindow codigo={e.codigo} archivo={e.archivo} />
						<p class="nota">
							<span aria-hidden="true">💡</span> {e.nota}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	for (const raiz of document.querySelectorAll<HTMLElement>('[data-pestanas]')) {
		const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const activar = (boton: HTMLButtonElement) => {
			for (const b of botones) {
				const activo = b === boton;
				b.setAttribute('aria-selected', String(activo));
				b.tabIndex = activo ? 0 : -1;
				const panel = document.getElementById(b.getAttribute('aria-controls') ?? '');
				if (panel) panel.hidden = !activo;
			}
		};
		botones.forEach((boton, i) => {
			boton.addEventListener('click', () => activar(boton));
			boton.addEventListener('keydown', (ev) => {
				const paso = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
				if (!paso) return;
				ev.preventDefault();
				const siguiente = botones[(i + paso + botones.length) % botones.length];
				if (!siguiente) return;
				activar(siguiente);
				siguiente.focus();
			});
		});
	}
</script>

<style>
	.lista {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.2rem;
	}
	[role='tab'] {
		font: inherit;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		color: var(--tinta-suave);
		background: rgb(255 255 255 / 0.03);
		border: 1px solid var(--linea);
		transition: all 0.2s ease;
	}
	[role='tab']:hover {
		color: var(--tinta);
		border-color: var(--indigo-vivo);
	}
	[role='tab'][aria-selected='true'] {
		color: #0b1424;
		background: var(--degradado);
		border-color: transparent;
	}
	.panel {
		animation: aparecer 0.35s ease;
	}
	@keyframes aparecer {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}
	.nota {
		margin: 1.2rem 0 0;
		padding: 1rem 1.2rem;
		border-radius: 14px;
		background: rgb(94 177 199 / 0.07);
		border: 1px solid rgb(94 177 199 / 0.25);
		color: var(--tinta);
	}
</style>
