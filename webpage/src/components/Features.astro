---
const caracteristicas = [
	{
		simbolo: 'ñ',
		color: 'var(--celeste)',
		titulo: 'Sintaxis en español',
		texto: 'Palabras como si, sino, repetir y casos. Lees el código en voz alta y tiene sentido.',
		muestra: 'si nota >= 90 "¡Excelente!" sino "¡Bien!"',
	},
	{
		simbolo: 'T',
		color: 'var(--pervinca)',
		titulo: 'Tipos que te cuidan',
		texto: 'Tipado estático con inferencia: escribes poco y el compilador atrapa los errores antes de ejecutar.',
		muestra: 'var puntos = 10  // entero',
	},
	{
		simbolo: 'T?',
		color: 'var(--turquesa)',
		titulo: 'Adiós a los nulos',
		texto: 'Opcionales T? y resultados T! explícitos, con casos exhaustivo. Ningún valor desaparece por sorpresa.',
		muestra: 'var nombre = usuario.apodo o "Anónimo"',
	},
	{
		simbolo: 'Go',
		color: 'var(--hielo)',
		titulo: 'Rápido de verdad',
		texto: 'Compila a Go: obtienes un ejecutable nativo, veloz y fácil de compartir.',
		muestra: 'cometa construir juego.cometa -o juego.exe',
	},
	{
		simbolo: '▶',
		color: 'var(--estrella)',
		titulo: 'Juegos 2D incluidos',
		texto: 'Pincel trae gráficos, entrada, audio y un modo retro con fuentes e íconos pixelados.',
		muestra: 'retro.icono(.Corazon, 8, 24, color = .Rojo)',
	},
	{
		simbolo: '{ }',
		color: 'var(--lavanda)',
		titulo: 'Tu editor te ayuda',
		texto: 'Extensión de VS Code con servidor de lenguaje: errores en vivo, autocompletado y navegación.',
		muestra: 'imprimir(a_cadena(.V4))  // ← sugerencias',
	},
];
---

<section id="caracteristicas" class="seccion">
	<div class="contenedor">
		<div class="encabezado">
			<span class="etiqueta">// por qué cometa</span>
			<h2>Fácil para empezar.<br /><span class="resaltado">Potente para crecer.</span></h2>
			<p>
				Cometa elimina el ruido para que te concentres en las ideas, sin esconder los conceptos que usan los
				lenguajes profesionales.
			</p>
		</div>

		<ul class="rejilla">
			{
				caracteristicas.map((c) => (
					<li class="tarjeta">
						<span class="simbolo" style={`--c:${c.color}`}>
							{c.simbolo}
						</span>
						<h3>{c.titulo}</h3>
						<p>{c.texto}</p>
						<code class="muestra">{c.muestra}</code>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.rejilla {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tarjeta {
		display: flex;
		flex-direction: column;
	}
	.simbolo {
		display: grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 14px;
		margin-bottom: 1.2rem;
		font-family: var(--fuente-codigo);
		font-weight: 600;
		font-size: 1.2rem;
		color: var(--c);
		background: color-mix(in srgb, var(--c) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
	}
	.tarjeta p {
		color: var(--tinta-suave);
		flex: 1;
	}
	.muestra {
		display: block;
		font-size: 0.78rem;
		padding: 0.6rem 0.8rem;
		border-radius: 10px;
		background: #1b1c36;
		border: 1px solid var(--linea);
		color: var(--tinta-suave);
		white-space: nowrap;
		overflow-x: auto;
	}
</style>
