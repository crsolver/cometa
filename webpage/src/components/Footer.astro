---
import Logo from './Logo.astro';
---

<footer class="pie">
	<div class="contenedor pie-interior">
		<div>
			<Logo size={30} />
			<p>Un lenguaje de programación en español, para aprender y para crear.</p>
		</div>
		<p class="derechos">Hecho con ☄️ para la comunidad hispanohablante.</p>
	</div>
</footer>

<style>
	.pie {
		border-top: 1px solid var(--linea);
		padding-block: 2.5rem;
		color: var(--tinta-suave);
		font-size: 0.95rem;
	}
	.pie-interior {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem;
	}
	.pie p {
		margin: 0.6rem 0 0;
	}
	.pie :global(.logo-texto) {
		font-size: 1.3rem;
	}
</style>
