---
import CodeWindow from './CodeWindow.astro';
import juego from '../ejemplos/juego.cometa?raw';

const modulos = ['', 'graficos', 'entrada', 'audio', 'recursos', 'tiempo', 'retro'];
---

<section id="juegos" class="seccion juegos">
	<div class="contenedor rejilla">
		<div>
			<span class="etiqueta">// pincel</span>
			<h2>Aprende <span class="resaltado">jugando.</span></h2>
			<p class="texto">
				Pincel es la biblioteca de juegos 2D de Cometa. Implementa <code>actualizar</code> y <code>pintar</code>,
				llama a <code>pincel.ejecutar</code> y ya tienes una ventana con tu juego. Sin configuración, sin
				archivos extra.
			</p>
			<ul class="modulos" aria-label="Módulos de Pincel">
				{modulos.map((m) => <li>std/pincel{m && '/' + m}</li>)}
			</ul>
			<p class="texto">
				¿Sin dibujos? El módulo <code>retro</code> incluye fuentes pixeladas e íconos de fantasía listos para usar.
				Activa <code>pixelado = verdadero</code> para un estilo nítido de 8 bits.
			</p>
		</div>

		<div class="demo">
			<div class="pantalla" aria-hidden="true">
				<span class="hud">♥♥♥ &nbsp; PUNTOS 0420</span>
				<span class="jugador"></span>
				<span class="objetivo"></span>
				<span class="suelo"></span>
			</div>
			<CodeWindow codigo={juego} archivo="mi_juego.cometa" />
		</div>
	</div>
</section>

<style>
	.juegos {
		background:
			radial-gradient(600px 400px at 90% 30%, rgb(166 221 234 / 0.08), transparent 70%),
			linear-gradient(180deg, transparent, rgb(104 112 184 / 0.06), transparent);
	}
	.rejilla {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.texto {
		color: var(--tinta-suave);
		font-size: 1.1rem;
	}
	.modulos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
	}
	.modulos li {
		font-family: var(--fuente-codigo);
		font-size: 0.8rem;
		padding: 0.35rem 0.7rem;
		border-radius: 8px;
		border: 1px solid var(--linea);
		background: var(--noche-2);
		color: var(--pervinca);
	}
	.demo {
		position: relative;
		min-width: 0;
		display: grid;
		gap: 1rem;
	}
	.pantalla {
		position: relative;
		height: 150px;
		border-radius: var(--radio);
		border: 4px solid var(--noche-3);
		background:
			linear-gradient(rgb(255 255 255 / 0.03) 50%, transparent 50%) 0 0 / 100% 4px,
			#080913;
		overflow: hidden;
		image-rendering: pixelated;
		box-shadow: 0 0 0 1px var(--linea), 0 20px 60px -20px rgb(166 221 234 / 0.25);
	}
	.hud {
		position: absolute;
		top: 10px;
		left: 14px;
		font-family: var(--fuente-codigo);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--lavanda);
	}
	.jugador {
		position: absolute;
		bottom: 28px;
		left: 10%;
		width: 20px;
		height: 20px;
		background: var(--estrella);
		box-shadow: 0 0 14px var(--estrella);
		animation: correr 4s steps(24) infinite alternate;
	}
	.objetivo {
		position: absolute;
		bottom: 64px;
		right: 18%;
		width: 12px;
		height: 12px;
		background: var(--turquesa);
		box-shadow: 0 0 12px var(--turquesa);
		animation: flotar 1.2s steps(4) infinite alternate;
	}
	.suelo {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 28px;
		background:
			repeating-linear-gradient(90deg, var(--indigo-vivo) 0 14px, #404576 14px 28px);
		border-top: 3px solid var(--pervinca);
	}
	@keyframes correr {
		to {
			left: 78%;
		}
	}
	@keyframes flotar {
		to {
			transform: translateY(-8px);
		}
	}
	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: 1fr;
		}
	}
</style>
