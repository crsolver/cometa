---
import CodeWindow from './CodeWindow.astro';
import { GITHUB } from '../lib/sitio';

const pasos = [
	{
		titulo: 'Construye el compilador',
		texto: 'Necesitas Go 1.25+ y Node.js. Un solo comando compila la extensión y el ejecutable cometa.',
		codigo: 'cd vscode-extension\nnpm install\nnpm run build',
	},
	{
		titulo: 'Escribe y ejecuta',
		texto: 'Crea hola.cometa con tu primer programa y ejecútalo directamente.',
		codigo: 'cometa ejecutar hola.cometa',
	},
	{
		titulo: 'Compártelo',
		texto: 'Genera un ejecutable nativo, o mira el código Go que produce Cometa.',
		codigo: 'cometa construir hola.cometa -o hola.exe\ncometa compilar hola.cometa -o hola.go',
	},
];
---

<section id="empezar" class="seccion">
	<div class="contenedor">
		<div class="encabezado">
			<span class="etiqueta">// empezar</span>
			<h2>Despega en <span class="resaltado">tres pasos.</span></h2>
			<p>
				Instala la extensión de VS Code para tener resaltado, errores en vivo y autocompletado mientras
				escribes.
			</p>
		</div>

		<ol class="pasos">
			{
				pasos.map((p, i) => (
					<li class="tarjeta paso">
						<span class="numero">{i + 1}</span>
						<h3>{p.titulo}</h3>
						<p>{p.texto}</p>
						<CodeWindow codigo={p.codigo} consola />
					</li>
				))
			}
		</ol>

		<div class="cta">
			<h3>¿Listo para escribir tu primera línea en español?</h3>
			<div class="cta-acciones">
				<a class="boton boton-principal" href={GITHUB}>Ver en GitHub <span aria-hidden="true">→</span></a>
				<a class="boton boton-secundario" href="/tour/">Hacer el tour</a>
				<a class="boton boton-secundario" href="/biblioteca/">Biblioteca estándar</a>
			</div>
		</div>
	</div>
</section>

<style>
	.pasos {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 1.2rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.paso {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.paso p {
		color: var(--tinta-suave);
		flex: 1;
	}
	.numero {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		margin-bottom: 1rem;
		font-family: var(--fuente-titulo);
		font-weight: 800;
		font-size: 1.3rem;
		color: #0b1424;
		background: var(--degradado);
	}
	.paso :global(.ventana pre) {
		font-size: 0.8rem;
		padding: 0.9rem 1rem;
	}
	.cta {
		margin-top: 4rem;
		padding: clamp(2rem, 5vw, 3.2rem);
		border-radius: calc(var(--radio) + 6px);
		text-align: center;
		background:
			radial-gradient(500px 200px at 50% 0%, rgb(94 177 199 / 0.25), transparent 70%),
			var(--noche-2);
		border: 1px solid var(--linea);
	}
	.cta h3 {
		font-size: clamp(1.6rem, 3.5vw, 2.3rem);
		margin-bottom: 1.5rem;
	}
	.cta-acciones {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
	}
</style>
