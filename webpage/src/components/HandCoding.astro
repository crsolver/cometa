---
import CodeWindow from './CodeWindow.astro';
import aMano from '../ejemplos/a_mano.cometa?raw';

const razones = [
	{
		icono: '🎮',
		color: 'var(--celeste)',
		titulo: 'Es un juego',
		texto: 'Cada error es un acertijo y cada solución, una pequeña victoria. Programar se parece más a jugar que a estudiar.',
	},
	{
		icono: '✨',
		color: 'var(--estrella)',
		titulo: 'El momento «¡funciona!»',
		texto: 'No hay nada como ejecutar algo que construiste tú y ver que hace exactamente lo que imaginaste.',
	},
	{
		icono: '🧠',
		color: 'var(--lavanda)',
		titulo: 'Entiendes de verdad',
		texto: 'Cuando lo escribes, sabes por qué funciona. Y si sabes por qué, puedes cambiarlo, arreglarlo y mejorarlo.',
	},
	{
		icono: '🎨',
		color: 'var(--turquesa)',
		titulo: 'Es creativo',
		texto: 'No hay una sola respuesta. Tu código tiene tu estilo, como un dibujo o una canción.',
	},
];

// Chispas decorativas alrededor del mensaje final.
const chispas = [
	{ x: -6, y: 10, d: 0 },
	{ x: 96, y: -8, d: 0.4 },
	{ x: 104, y: 70, d: 0.8 },
	{ x: 30, y: 108, d: 1.2 },
	{ x: 70, y: -14, d: 1.6 },
];
---

<section id="a-mano" class="seccion">
	<div class="contenedor">
		<div class="cabecera">
			<div>
				<span class="etiqueta">// programar a mano</span>
				<h2>Programar a mano es <span class="resaltado">divertido.</span></h2>
				<p class="bajada">
					Como tocar un instrumento o armar un rompecabezas: el gusto está en hacerlo tú. Las herramientas
					pueden escribir código, pero la emoción de ver tu idea cobrar vida, línea por línea, es tuya.
				</p>
			</div>

			<div class="momento">
				<CodeWindow codigo={aMano} archivo="mi_idea.cometa" />
				<div class="exito" aria-label="Salida del programa">
					<span class="exito-lineas">Nivel 1: ★<br />Nivel 2: ★★<br />Nivel 3: ★★★</span>
					<strong>¡Lo hice yo! 🎉</strong>
					{
						chispas.map((c) => (
							<i
								class="chispa"
								aria-hidden="true"
								style={`left:${c.x}%;top:${c.y}%;animation-delay:${c.d}s`}
							/>
						))
					}
				</div>
			</div>
		</div>

		<ul class="razones">
			{
				razones.map((r) => (
					<li class="tarjeta">
						<span class="icono" style={`--c:${r.color}`} aria-hidden="true">
							{r.icono}
						</span>
						<h3>{r.titulo}</h3>
						<p>{r.texto}</p>
					</li>
				))
			}
		</ul>

		<div class="cierre">
			<p>Cometa está hecho para eso: <span class="resaltado">para que escribir código se sienta como jugar.</span></p>
			<a class="boton boton-secundario" href="#empezar">Escribe tu primera línea <span aria-hidden="true">→</span></a>
		</div>
	</div>
</section>

<style>
	.cabecera {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		margin-bottom: 3.5rem;
	}
	.bajada {
		color: var(--tinta-suave);
		font-size: 1.2rem;
		max-width: 34rem;
	}
	.momento {
		position: relative;
		min-width: 0;
	}
	.exito {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		width: min(17rem, 80%);
		margin: -1.8rem 0 0 auto;
		margin-right: 1rem;
		padding: 1rem 1.2rem;
		border-radius: 16px;
		background: var(--noche-2);
		border: 1px solid rgb(242 208 138 / 0.4);
		box-shadow: 0 20px 50px -15px rgb(242 208 138 / 0.3);
		transform: rotate(-2deg);
	}
	.exito-lineas {
		font-family: var(--fuente-codigo);
		font-size: 0.8rem;
		color: var(--turquesa);
	}
	.exito strong {
		font-family: var(--fuente-titulo);
		font-size: 1.6rem;
		line-height: 1.1;
		color: var(--estrella);
	}
	.chispa {
		position: absolute;
		width: 14px;
		height: 14px;
		background: var(--estrella);
		clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
		animation: brillar 2s ease-in-out infinite;
	}
	.chispa:nth-of-type(even) {
		background: var(--hielo);
		width: 10px;
		height: 10px;
	}
	@keyframes brillar {
		0%, 100% {
			transform: scale(0.3) rotate(0);
			opacity: 0;
		}
		50% {
			transform: scale(1) rotate(90deg);
			opacity: 1;
		}
	}
	.razones {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.icono {
		display: grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 14px;
		margin-bottom: 1.1rem;
		font-size: 1.5rem;
		background: color-mix(in srgb, var(--c) 16%, transparent);
		border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
	}
	.razones p {
		color: var(--tinta-suave);
		margin: 0;
	}
	.cierre {
		margin-top: 3.5rem;
		text-align: center;
	}
	.cierre p {
		font-family: var(--fuente-titulo);
		font-weight: 700;
		font-size: clamp(1.5rem, 3.2vw, 2.2rem);
		line-height: 1.25;
		max-width: 44rem;
		margin: 0 auto 1.5rem;
	}
	@media (max-width: 900px) {
		.cabecera {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.chispa {
			animation: none;
			opacity: 0.8;
		}
	}
</style>
