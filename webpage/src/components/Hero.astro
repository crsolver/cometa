---
import CodeWindow from './CodeWindow.astro';
import hola from '../ejemplos/hola.cometa?raw';

const salida = ['¡Hola, Ana! Estás en el nivel 3.', 'Despegue en 3...', 'Despegue en 2...', 'Despegue en 1...', '¡Vuela, cometa!'];

// Estrellas decorativas con posiciones fijas para que el resultado sea estable.
const estrellas = Array.from({ length: 28 }, (_, i) => ({
	x: (i * 37.3) % 100,
	y: (i * 53.7) % 100,
	t: 1 + (i % 3),
	d: (i % 7) * 0.6,
}));
---

<section class="hero">
	<div class="cielo" aria-hidden="true">
		{estrellas.map((e) => <i style={`left:${e.x}%;top:${e.y}%;width:${e.t}px;height:${e.t}px;animation-delay:${e.d}s`}></i>)}
		<span class="estela"></span>
	</div>

	<div class="contenedor hero-interior">
		<div class="hero-texto">
			<span class="insignia"><b>Nuevo</b> Juegos 2D con Pincel ✨</span>
			<h1>Programa en <span class="resaltado">tu idioma.</span></h1>
			<p class="bajada">
				Cometa es un lenguaje tipado, claro y divertido, con sintaxis en español. Aprende a programar desde
				cero o construye juegos y herramientas de verdad, compilados a Go.
			</p>
			<div class="acciones">
				<a class="boton boton-principal" href="#empezar">Empezar ahora <span aria-hidden="true">→</span></a>
				<a class="boton boton-secundario" href="#ejemplos">Ver ejemplos</a>
			</div>
			<ul class="datos">
				<li><strong>Tipado</strong> estático</li>
				<li><strong>Sin</strong> nulos</li>
				<li><strong>Compila</strong> a Go</li>
			</ul>
		</div>

		<div class="hero-codigo">
			<CodeWindow codigo={hola} archivo="hola.cometa" />
			<div class="salida" aria-label="Salida del programa">
				<span class="salida-titulo">▶ cometa ejecutar hola.cometa</span>
				{salida.map((linea) => <span>{linea}</span>)}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
	}
	.cielo {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.cielo i {
		position: absolute;
		border-radius: 50%;
		background: #fff;
		opacity: 0.5;
		animation: titilar 3.5s ease-in-out infinite;
	}
	@keyframes titilar {
		50% {
			opacity: 0.1;
		}
	}
	.estela {
		position: absolute;
		top: 12%;
		left: -30%;
		width: 260px;
		height: 3px;
		border-radius: 3px;
		background: linear-gradient(90deg, transparent, var(--lavanda), var(--hielo));
		box-shadow: 0 0 18px var(--celeste);
		transform: rotate(-18deg);
		animation: cruzar 9s ease-in 1.5s infinite;
		opacity: 0;
	}
	.estela::after {
		content: '';
		position: absolute;
		right: -4px;
		top: -4px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #eaf8fc;
		box-shadow: 0 0 16px 4px var(--hielo);
	}
	@keyframes cruzar {
		0% {
			transform: translate(0, 0) rotate(-18deg);
			opacity: 0;
		}
		5% {
			opacity: 1;
		}
		22% {
			transform: translate(160vw, -30vh) rotate(-18deg);
			opacity: 0;
		}
		100% {
			transform: translate(160vw, -30vh) rotate(-18deg);
			opacity: 0;
		}
	}
	.hero-interior {
		position: relative;
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.insignia {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.3rem 0.9rem 0.3rem 0.35rem;
		border-radius: 999px;
		border: 1px solid var(--linea);
		background: rgb(255 255 255 / 0.03);
		font-size: 0.9rem;
		color: var(--tinta-suave);
		margin-bottom: 1.5rem;
	}
	.insignia b {
		background: var(--turquesa);
		color: #0b1424;
		border-radius: 999px;
		padding: 0.1rem 0.6rem;
		font-size: 0.78rem;
	}
	h1 {
		font-size: clamp(2.8rem, 7vw, 5.2rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 1.4rem;
	}
	.bajada {
		font-size: clamp(1.1rem, 1.6vw, 1.3rem);
		color: var(--tinta-suave);
		max-width: 34rem;
		margin-bottom: 2rem;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-bottom: 2.4rem;
	}
	.datos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.6rem;
		list-style: none;
		padding: 0;
		margin: 0;
		color: var(--tinta-suave);
		font-size: 0.95rem;
	}
	.datos li::before {
		content: '✦ ';
		color: var(--hielo);
	}
	.datos strong {
		color: var(--tinta);
	}
	.hero-codigo {
		position: relative;
		min-width: 0;
	}
	.hero-codigo::before {
		content: '';
		position: absolute;
		inset: 10% -5% -5% 10%;
		background: radial-gradient(closest-side, rgb(94 177 199 / 0.35), transparent);
		filter: blur(30px);
		z-index: -1;
	}
	.salida {
		display: flex;
		flex-direction: column;
		margin: -1.5rem 1rem 0 auto;
		position: relative;
		width: min(20rem, 85%);
		padding: 0.9rem 1.1rem;
		border-radius: 14px;
		background: #1b1c36;
		border: 1px solid var(--linea);
		font-family: var(--fuente-codigo);
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--turquesa);
		box-shadow: 0 20px 40px -15px rgb(0 0 0 / 0.8);
		transform: rotate(1.5deg);
	}
	.salida-titulo {
		color: var(--tinta-suave);
		margin-bottom: 0.3rem;
	}
	@media (max-width: 900px) {
		.hero-interior {
			grid-template-columns: 1fr;
		}
	}
</style>
