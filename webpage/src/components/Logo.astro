---
interface Props {
	size?: number;
	wordmark?: boolean;
	class?: string;
}
const { size = 40, wordmark = true, class: clase } = Astro.props;
// Identificadores únicos para que varios logos en la página no compartan gradientes.
const id = Math.random().toString(36).slice(2, 8);
---

<span class:list={['logo', clase]}>
	<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class="logo-icono">
		<defs>
			<linearGradient id={`orbita-${id}`} x1="0" y1="1" x2="0" y2="0">
				<stop offset="0" stop-color="#404576" stop-opacity="0.15"></stop>
				<stop offset=".5" stop-color="#4F6B9A"></stop>
				<stop offset="1" stop-color="#5EB1C7"></stop>
			</linearGradient>
			<radialGradient id={`halo-${id}`}>
				<stop offset="0" stop-color="#5EB1C7" stop-opacity=".55"></stop>
				<stop offset="1" stop-color="#5EB1C7" stop-opacity="0"></stop>
			</radialGradient>
		</defs>
		<!-- La trayectoria del cometa dibuja una C que se abre hacia la derecha. -->
		<path d="M47.3 44.9 A20 20 0 1 1 47.3 19.1" fill="none" stroke={`url(#orbita-${id})`} stroke-width="5" stroke-linecap="round"></path>
		<path d="M19.1 16.7 A20 20 0 0 1 47.3 19.1" fill="none" stroke="#5EB1C7" stroke-width="8" stroke-linecap="round"></path>
		<path d="M29.9 12.1 A20 20 0 0 1 47.3 19.1" fill="none" stroke="#A6DDEA" stroke-width="4" stroke-linecap="round"></path>
		<circle cx="47.3" cy="19.1" r="13" fill={`url(#halo-${id})`}></circle>
		<circle cx="47.3" cy="19.1" r="6.5" fill="#EAF8FC"></circle>
		<path class="logo-chispa" d="M32 24.5 l2.2 5.3 5.3 2.2 -5.3 2.2 -2.2 5.3 -2.2 -5.3 -5.3 -2.2 5.3 -2.2z" fill="#F2D08A"></path>
	</svg>
	{wordmark && <span class="logo-texto">cometa</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--tinta);
	}
	.logo-texto {
		font-family: var(--fuente-titulo);
		font-weight: 800;
		font-size: 1.6rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.logo-icono {
		flex: none;
		overflow: visible;
	}
	.logo-chispa {
		transform-origin: 32px 32px;
		animation: chispa 3s ease-in-out infinite;
	}
	@keyframes chispa {
		0%, 100% { transform: scale(1) rotate(0); opacity: 1; }
		50% { transform: scale(0.6) rotate(45deg); opacity: 0.7; }
	}
	@media (prefers-reduced-motion: reduce) {
		.logo-chispa { animation: none; }
	}
</style>
