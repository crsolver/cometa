---
import Logo from './Logo.astro';
import { GITHUB } from '../lib/sitio';

const enlaces = [
	{ href: '/tour/', texto: 'Tour' },
	{ href: '/biblioteca/', texto: 'Biblioteca' },
	{ href: '/guias/', texto: 'Guías' },
	{ href: '/referencia/', texto: 'Referencia' },
	{ href: '/#ejemplos', texto: 'Ejemplos' },
];
---

<header class="nav">
	<div class="contenedor nav-interior">
		<a href="/" class="nav-logo" aria-label="Cometa, inicio"><Logo size={36} /></a>
		<nav aria-label="Principal">
			<ul>
				{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
			</ul>
		</nav>
		<a class="boton boton-secundario nav-gh" href={GITHUB}>GitHub</a>
		<details class="menu">
			<summary aria-label="Menú">☰</summary>
			<ul>
				{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
				<li><a href={GITHUB}>GitHub</a></li>
			</ul>
		</details>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px);
		background: rgb(36 38 70 / 0.8);
		border-bottom: 1px solid rgb(61 64 112 / 0.6);
	}
	.nav-interior {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4.2rem;
	}
	.nav-logo {
		text-decoration: none;
	}
	ul {
		display: flex;
		gap: 0.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul a {
		color: var(--tinta-suave);
		text-decoration: none;
		font-weight: 500;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		transition: color 0.2s, background 0.2s;
	}
	ul a:hover {
		color: var(--tinta);
		background: rgb(255 255 255 / 0.06);
	}
	.nav-gh {
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
	}
	.menu {
		display: none;
		position: relative;
	}
	.menu summary {
		list-style: none;
		cursor: pointer;
		font-size: 1.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--linea);
		border-radius: 10px;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu ul {
		position: absolute;
		right: 0;
		top: 3rem;
		flex-direction: column;
		min-width: 13rem;
		background: var(--noche-2);
		border: 1px solid var(--linea);
		border-radius: 14px;
		padding: 0.5rem;
	}
	@media (max-width: 960px) {
		nav,
		.nav-gh {
			display: none;
		}
		.menu {
			display: block;
		}
	}
</style>
