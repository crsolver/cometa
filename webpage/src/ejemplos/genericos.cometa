// Las interfaces se cumplen solo con tener los métodos.
interfaz Describible
	fn describir() cadena

tipo Planeta
	nombre cadena
	lunas entero
	pub fn describir() cadena "${@nombre} tiene ${@lunas} lunas"

tipo Caja<T>
	valor T
	pub fn obtener() T @valor

fn anunciar<T Describible>(cosa T) cadena
	"📡 " + cosa.describir()

fn inicio()
	var caja = Caja<Planeta> {valor: Planeta {nombre: "Júpiter", lunas: 95}}
	imprimir(anunciar(caja.obtener()))
