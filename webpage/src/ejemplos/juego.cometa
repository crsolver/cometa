usar std/mate
usar std/pincel
usar std/pincel/graficos
usar std/pincel/entrada

tipo Partida
	pos mate.Vec2

	pub fn actualizar(dt decimal)
		var direccion = mate.Vec2 {}
		si entrada.tecla_mantenida(.Derecha)
			direccion.x = 1
		si entrada.tecla_mantenida(.Izquierda)
			direccion.x = -1
		@pos = @pos + direccion * 120 * dt

	pub fn pintar()
		graficos.limpiar(.Negro)
		graficos.rectangulo_v(@pos, {16, 16}, .Amarillo)

fn inicio()
	pincel.ejecutar(Partida {pos: {x: 150, y: 80}}, titulo = "Mi cometa") atrapar |error|
		imprimir(error)
