{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cometa",
  "scopeName": "source.cometa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#enum-patterns" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#receiver-members" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "imports": {
      "patterns": [{
        "match": "^(usar)\\s+((?:\\.\\.?/)*[\\p{L}_][\\p{L}\\p{N}_]*(?:/[\\p{L}_][\\p{L}\\p{N}_]*)*)(?:\\s+(como)\\s+([\\p{L}_][\\p{L}\\p{N}_]*))?",
        "captures": {
          "1": { "name": "keyword.control.import.cometa" },
          "2": { "name": "entity.name.namespace.cometa" },
          "3": { "name": "keyword.control.cometa" },
          "4": { "name": "entity.name.namespace.cometa" }
        }
      }]
    },
    "enum-patterns": {
      "patterns": [{
        "match": "^(\\t+)(?:([A-Za-z_][A-Za-z0-9_]*))?(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=>)",
        "captures": {
          "2": { "name": "entity.name.type.cometa" },
          "3": { "name": "punctuation.accessor.cometa" },
          "4": { "name": "constant.other.enum.cometa" }
        }
      }]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cometa",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.cometa" } },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cometa",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cometa" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.cometa" } },
          "patterns": [
			{ "include": "#interpolation" },
			{ "name": "constant.character.escape.cometa", "match": "\\\\\\$\\{" },
            { "name": "constant.character.escape.cometa", "match": "\\\\(?:[\\\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})" }
          ]
        }
      ]
    },
	"interpolation": {
	  "patterns": [{
		"name": "meta.interpolation.cometa",
		"begin": "\\$\\{",
		"beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.cometa" } },
		"end": "\\}",
		"endCaptures": { "0": { "name": "punctuation.section.interpolation.end.cometa" } },
		"patterns": [
		  { "include": "#interpolation" },
		  { "include": "$self" }
		]
	  }]
	},
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.cometa" },
            "3": { "name": "entity.name.function.cometa" }
          }
        },
        {
          "match": "\\b(tipo|enum|interfaz)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.cometa" },
            "3": { "name": "entity.name.type.cometa" }
          }
        },
        {
          "match": "\\b(var|const)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.cometa" },
            "3": { "name": "variable.other.readwrite.cometa" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
		{ "name": "storage.modifier.cometa", "match": "\\bpub\\b" },
        { "name": "keyword.control.conditional.cometa", "match": "\\b(?:con|si|osi|sino|casos|o|atrapar|intentar|retornar|como)\\b" },
        { "name": "keyword.control.loop.cometa", "match": "\\b(?:repetir|mientras|continuar|romper)\\b" },
        { "name": "storage.type.function.cometa", "match": "\\bfn\\b" },
        { "name": "storage.type.struct.cometa", "match": "\\b(?:tipo|enum|interfaz)\\b" },
        { "name": "storage.type.variable.cometa", "match": "\\b(?:var|const)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.cometa", "match": "\\b(?:entero|decimal|bool|cadena)\\b" },
        { "name": "support.type.cometa", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.cometa", "match": "\\b(?:verdadero|falso)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.cometa", "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]+)?)(?![A-Za-z0-9_])" }
      ]
    },
    "receiver-members": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.cometa" },
            "2": { "name": "variable.other.member.cometa" }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.cometa" },
            "2": { "name": "variable.other.member.cometa" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        { "name": "support.function.builtin.cometa", "match": "\\bimprimir(?=\\s*\\()" },
        { "name": "entity.name.function.call.cometa", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.variadic.cometa", "match": "\\.\\.\\." },
        { "name": "keyword.operator.range.cometa", "match": "\\.\\." },
        { "name": "keyword.operator.cometa", "match": "=>|==|!=|<=|>=|[+\\-*/%]=|&&|\\|\\||[+\\-*/%=<>!?]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.cometa", "match": "," },
        { "name": "punctuation.separator.key-value.cometa", "match": ":" },
        { "name": "punctuation.accessor.cometa", "match": "\\." },
        { "name": "punctuation.section.group.cometa", "match": "[()\\[\\]{}]" },
        { "name": "punctuation.definition.parameters.cometa", "match": "\\|" }
      ]
    }
  }
}
