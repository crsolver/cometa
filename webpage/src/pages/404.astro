---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base titulo="Página no encontrada · Cometa" descripcion="Esta página se perdió en el espacio.">
	<Nav />
	<main class="contenedor seccion">
		<h2>Esta página se perdió <span class="resaltado">en el espacio.</span></h2>
		<p>No encontramos lo que buscabas. Prueba con el tour o la biblioteca estándar.</p>
		<p>
			<a class="boton boton-principal" href="/tour/">Ir al tour</a>
			<a class="boton boton-secundario" href="/">Inicio</a>
		</p>
	</main>
	<Footer />
</Base>
