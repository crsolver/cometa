---
import Docs from '../../layouts/Docs.astro';
import CodeWindow from '../../components/CodeWindow.astro';
import { biblioteca } from '../../lib/biblioteca';

export function getStaticPaths() {
	return biblioteca.map((m, i) => ({
		params: { modulo: m.nombre },
		props: { m, anterior: biblioteca[i - 1], siguiente: biblioteca[i + 1] },
	}));
}
const { m, anterior, siguiente } = Astro.props;
const enlace = (x: { nombre: string } | undefined) =>
	x ? { href: `/biblioteca/${x.nombre}/`, texto: x.nombre } : undefined;

const encabezados: { depth: number; slug: string; text: string }[] = [];
if (m.tipos.length) encabezados.push({ depth: 2, slug: 'tipos', text: 'Tipos' });
if (m.funciones.length) encabezados.push({ depth: 2, slug: 'funciones', text: 'Funciones' });
---

<Docs
	titulo={`${m.nombre} · biblioteca`}
	descripcion={m.doc ?? `Módulo ${m.nombre} de la biblioteca estándar de Cometa.`}
	encabezados={encabezados}
	anterior={enlace(anterior)}
	siguiente={enlace(siguiente)}
>
	<h1>{m.nombre}</h1>
	<p class="lead">{m.doc}</p>
	<CodeWindow codigo={`usar ${m.ruta}`} archivo="importar" />

	{
		m.constantes && m.constantes.length > 0 && (
			<>
				<h2 id="constantes">Constantes</h2>
				{m.constantes.map((c) => (
					<div class="simbolo" id={c.split(' ')[0]}>
						<h3>{m.nombre}.{c}</h3>
					</div>
				))}
			</>
		)
	}

	{
		m.tipos.length > 0 && (
			<>
				<h2 id="tipos">Tipos</h2>
				{m.tipos.map((t) => (
					<div class="simbolo" id={t.nombre}>
						<h3>
							{m.nombre}.{t.nombre}
							{t.interfaz && <span class="marca">interfaz</span>}
						</h3>
						{t.doc && <p>{t.doc}</p>}
						{t.campos && t.campos.length > 0 && (
							<div class="chips">
								{t.campos.map((c) => <code>{c}</code>)}
							</div>
						)}
						{t.constantes && t.constantes.length > 0 && (
							<>
								<p><small>Valores:</small></p>
								<div class="chips">
									{t.constantes.map((c) => <code>{c}</code>)}
								</div>
							</>
						)}
						{t.metodos && t.metodos.map((f) => (
							<div class="simbolo" id={`${t.nombre}-${f.nombre}`}>
								<h4>{t.nombre}.{f.firma}</h4>
								{f.doc && <p>{f.doc}</p>}
							</div>
						))}
					</div>
				))}
			</>
		)
	}

	<h2 id="funciones">Funciones</h2>
	{
		m.funciones.map((f) => (
			<div class="simbolo" id={f.nombre}>
				<h3>
					{m.nombre}.{f.firma}
					{f.dibujo && <span class="marca">al pintar</span>}
					{f.recurso && <span class="marca">recurso</span>}
				</h3>
				{f.doc && <p>{f.doc}</p>}
			</div>
		))
	}
</Docs>
