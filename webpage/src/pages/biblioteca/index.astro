---
import Docs from '../../layouts/Docs.astro';
import { biblioteca } from '../../lib/biblioteca';
---

<Docs
	titulo="Biblioteca estándar"
	descripcion="Referencia de los módulos de la biblioteca estándar de Cometa: mate, azar, pruebas y Pincel."
>
	<h1>Biblioteca estándar</h1>
	<p class="lead">
		Cada archivo importa explícitamente lo que usa, por ejemplo <code>usar std/mate</code> o
		<code>usar std/pincel/graficos</code>, y llama a sus funciones con el nombre del módulo:
		<code>mate.raiz(2)</code>. Esta referencia se genera desde el catálogo del compilador.
	</p>
	<div class="rejilla-modulos">
		{
			biblioteca.map((m) => (
				<a class="tarjeta" href={`/biblioteca/${m.nombre}/`}>
					<strong>{m.nombre}</strong>
					<code>{m.ruta}</code>
					<p>{m.doc?.split('. ')[0]}</p>
				</a>
			))
		}
	</div>
</Docs>
