---
import { getEntry, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

const entry = await getEntry('referencia', 'specs');
if (!entry) throw new Error('No se encontró specs.md');
const { Content, headings } = await render(entry);
---

<Docs
	titulo="Referencia del lenguaje"
	descripcion="Especificación completa del lenguaje Cometa: tipos, funciones, enums, errores, módulos y más."
	encabezados={headings}
>
	<Content />
</Docs>
