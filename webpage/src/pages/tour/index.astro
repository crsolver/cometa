---
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

const lecciones = (await getCollection('tour')).sort((a, b) => a.data.orden - b.data.orden);
---

<Docs titulo="Tour del lenguaje" descripcion="Aprende Cometa paso a paso, desde tu primer programa hasta tu primer juego.">
	<h1>Tour del lenguaje</h1>
	<p class="lead">
		Catorce lecciones cortas para recorrer Cometa, desde «Hola, mundo» hasta un juego con Pincel. Cada una termina con un
		programa completo que puedes copiar y ejecutar.
	</p>
	<div class="rejilla-modulos">
		{
			lecciones.map((l) => (
				<a class="tarjeta" href={`/tour/${l.id}/`}>
					<code>lección {l.data.orden}</code>
					<strong>{l.data.titulo}</strong>
					<p>{l.data.resumen}</p>
				</a>
			))
		}
	</div>
</Docs>
